---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/common/PageHeader.astro';
---

<Layout title="ブログ | 汎用工務店テンプレート">
  <PageHeader title="ブログ" />

  <section class="py-20 px-4 max-w-6xl mx-auto">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
      {[...Array(9)].map(() => (
        <article class="space-y-3">
          <div class="aspect-[4/3] bg-neutral-200"></div>
          <div class="flex items-center gap-3 text-xs">
            <span class="text-neutral-500 font-mono">2018.01.01</span>
            <span class="px-2.5 py-1 bg-black text-white text-[10px] font-bold tracking-wider uppercase">CATEGORY</span>
          </div>
          <h2 class="font-bold text-xs text-neutral-800 leading-relaxed line-clamp-2">
            <a href="/blog/sample-post/" class="hover:underline">
              タイトルタイトルタイトルタイトルタイトルタイトルタイトルタイトルタイト
            </a>
          </h2>
        </article>
      ))}
    </div>

    <!-- ページネーション -->
    <div class="flex items-center justify-center gap-2 text-xs font-bold">
      <span class="w-10 h-10 bg-black text-white flex items-center justify-center">&lt;</span>
      <span class="w-10 h-10 bg-black text-white flex items-center justify-center">1</span>
      <a href="#" class="w-10 h-10 border border-neutral-300 flex items-center justify-center hover:bg-neutral-100">2</a>
      <span class="px-2 text-neutral-400">. . . . .</span>
      <a href="#" class="w-10 h-10 border border-neutral-300 flex items-center justify-center hover:bg-neutral-100">10</a>
    </div>
  </section>
</Layout>
