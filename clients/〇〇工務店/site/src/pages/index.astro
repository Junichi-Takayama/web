---
import Layout from '../layouts/Layout.astro';
---

<Layout title="トップページ | 汎用工務店テンプレート">
  <!-- 1. メインビジュアル -->
  <section class="relative bg-neutral-800 text-white h-[60vh] min-h-[380px] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 bg-neutral-900/30 z-10"></div>
    <div data-animate="fade-up" class="relative z-20 text-center px-4">
      <h1 class="text-4xl md:text-5xl font-bold tracking-widest mb-3">メインビジュアル</h1>
      <p class="text-xs md:text-sm text-neutral-300 tracking-widest uppercase">Ideal Living Space Solution</p>
    </div>
  </section>

  <!-- 2. メッセージセクション -->
  <section class="py-20 px-4 max-w-4xl mx-auto text-center overflow-hidden">
    <div data-animate="fade-up">
      <h2 class="text-3xl font-bold text-neutral-800 mb-1">セクション</h2>
      <p class="text-xs text-neutral-400 uppercase tracking-widest mb-8">SECTION</p>
      <p class="text-sm text-neutral-600 leading-relaxed mb-8 max-w-2xl mx-auto">
        これはダミーテキストです。メッセージが入ります。これはダミーテキストです。メッセージが入ります。これはダミーテキストです。
      </p>
      <a href="/company/" class="inline-block px-8 py-3 bg-neutral-800 text-white text-xs font-bold hover:bg-neutral-900 hover:scale-105 active:scale-95 transition-all duration-200 shadow-md">
        詳しく見る
      </a>
    </div>
  </section>

  <!-- 3. 左右交互セクション -->
  <section class="py-20 px-4 bg-neutral-50 border-t border-b border-neutral-200 overflow-hidden">
    <div class="max-w-6xl mx-auto space-y-20">
      <div class="text-center" data-animate="fade-up">
        <h2 class="text-3xl font-bold text-neutral-800 mb-1">セクション</h2>
        <p class="text-xs text-neutral-400 uppercase tracking-widest">SECTION</p>
      </div>

      <!-- ブロック1 -->
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="space-y-4" data-animate="slide-left">
          <h3 class="text-xl font-bold text-neutral-800 leading-snug">見出しが入ります。見出しが入ります。</h3>
          <p class="text-sm text-neutral-600 leading-relaxed">
            これはダミーテキストです。本文が入ります。これはダミーテキストです。
          </p>
          <a href="/works/" class="inline-block px-8 py-3 bg-neutral-800 text-white text-xs font-bold hover:bg-neutral-900 hover:scale-105 active:scale-95 transition-all duration-200 shadow-md">
            詳しく見る
          </a>
        </div>
        <div class="aspect-[4/3] bg-neutral-700 overflow-hidden group rounded-sm shadow-md" data-animate="slide-right">
          <div class="w-full h-full bg-neutral-700 group-hover:scale-105 transition-transform duration-500 ease-out"></div>
        </div>
      </div>

      <!-- ブロック2 -->
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="aspect-[4/3] bg-neutral-700 md:order-1 order-2 overflow-hidden group rounded-sm shadow-md" data-animate="slide-left">
          <div class="w-full h-full bg-neutral-700 group-hover:scale-105 transition-transform duration-500 ease-out"></div>
        </div>
        <div class="space-y-4 md:order-2 order-1" data-animate="slide-right">
          <h3 class="text-xl font-bold text-neutral-800 leading-snug">見出しが入ります。見出しが入ります。</h3>
          <p class="text-sm text-neutral-600 leading-relaxed">
            これはダミーテキストです。本文が入ります。これはダミーテキストです。
          </p>
          <a href="/works/" class="inline-block px-8 py-3 bg-neutral-800 text-white text-xs font-bold hover:bg-neutral-900 hover:scale-105 active:scale-95 transition-all duration-200 shadow-md">
            詳しく見る
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. 3カラムカードセクション -->
  <section class="py-20 px-4 max-w-6xl mx-auto overflow-hidden">
    <div class="text-center mb-12" data-animate="fade-up">
      <h2 class="text-3xl font-bold text-neutral-800 mb-1">セクション</h2>
      <p class="text-xs text-neutral-400 uppercase tracking-widest">SECTION</p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {[1, 2, 3].map((_, idx) => (
        <div class="space-y-4 group cursor-pointer" data-animate="fade-up" data-delay={(idx + 1) * 150}>
          <div class="aspect-[4/3] bg-neutral-700 overflow-hidden rounded-sm shadow-sm">
            <div class="w-full h-full bg-neutral-700 group-hover:scale-105 transition-transform duration-500 ease-out"></div>
          </div>
          <h3 class="font-bold text-sm text-neutral-800 leading-snug group-hover:text-neutral-600 transition-colors">見出しが入ります。見出しが入ります。見出しが入ります。</h3>
        </div>
      ))}
    </div>

    <div class="text-center mt-10" data-animate="fade-up">
      <a href="/works/" class="inline-block px-8 py-3 bg-neutral-800 text-white text-xs font-bold hover:bg-neutral-900 hover:scale-105 active:scale-95 transition-all duration-200 shadow-md">
        詳しく見る
      </a>
    </div>
  </section>

  <!-- 5. お知らせ風リストセクション -->
  <section class="py-20 px-4 bg-neutral-50 border-t border-neutral-200 overflow-hidden">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12" data-animate="fade-up">
        <h2 class="text-3xl font-bold text-neutral-800 mb-1">セクション</h2>
        <p class="text-xs text-neutral-400 uppercase tracking-widest">SECTION</p>
      </div>

      <div class="divide-y divide-neutral-200 border-t border-b border-neutral-200 mb-8 bg-white shadow-sm" data-animate="fade-up">
        {[1, 2, 3].map(() => (
          <div class="py-4 px-4 flex flex-col sm:flex-row sm:items-center gap-4 text-xs hover:bg-neutral-50 transition-colors duration-200">
            <span class="text-neutral-500">2023.01.01</span>
            <span class="px-2 py-1 bg-neutral-200 text-neutral-700 text-[10px] w-fit">カテゴリー名</span>
            <a href="/news/" class="text-neutral-800 font-medium hover:underline flex-grow">
              タイトルが入ります。タイトルが入ります。タイトルが入ります。
            </a>
          </div>
        ))}
      </div>

      <div class="text-center" data-animate="fade-up">
        <a href="/news/" class="inline-block px-8 py-3 bg-neutral-800 text-white text-xs font-bold hover:bg-neutral-900 hover:scale-105 active:scale-95 transition-all duration-200 shadow-md">
          詳しく見る
        </a>
      </div>
    </div>
  </section>

  <!-- 6. 2カラム複合セクション -->
  <section class="py-20 px-4 max-w-6xl mx-auto overflow-hidden">
    <div class="grid lg:grid-cols-2 gap-12">
      <!-- 左: サムネイルリスト -->
      <div data-animate="slide-left">
        <div class="text-center mb-8">
          <h2 class="text-2xl font-bold text-neutral-800 mb-1">セクション</h2>
          <p class="text-xs text-neutral-400 uppercase tracking-widest">SECTION</p>
        </div>
        <div class="space-y-4 mb-8">
          {[1, 2, 3].map(() => (
            <div class="flex gap-4 p-3 border border-neutral-200 hover:border-neutral-400 transition-all duration-200 bg-white shadow-sm hover:shadow group cursor-pointer">
              <div class="w-28 h-20 bg-neutral-700 flex-shrink-0 overflow-hidden">
                <div class="w-full h-full bg-neutral-700 group-hover:scale-105 transition-transform duration-300"></div>
              </div>
              <div class="space-y-1 text-xs">
                <span class="text-neutral-400">2023.01.01</span>
                <span class="ml-2 px-1.5 py-0.5 bg-neutral-200 text-neutral-700">カテゴリー名</span>
                <p class="font-bold text-neutral-800 group-hover:text-neutral-600 transition">記事タイトルが入ります。記事タイトルが入ります。</p>
              </div>
            </div>
          ))}
        </div>
        <div class="text-center">
          <a href="/blog/" class="inline-block px-8 py-3 bg-neutral-800 text-white text-xs font-bold hover:bg-neutral-900 hover:scale-105 active:scale-95 transition-all duration-200 shadow-md">
            詳しく見る
          </a>
        </div>
      </div>

      <!-- 右: 3x3 画像ギャラリー -->
      <div data-animate="slide-right">
        <div class="text-center mb-8">
          <h2 class="text-2xl font-bold text-neutral-800 mb-1">セクション</h2>
          <p class="text-xs text-neutral-400 uppercase tracking-widest">SECTION</p>
        </div>
        <div class="grid grid-cols-3 gap-3 mb-8">
          {[...Array(9)].map((_, idx) => (
            <div class="aspect-square bg-neutral-800 overflow-hidden group cursor-pointer shadow-sm" data-animate="scale-up" data-delay={(idx % 3) * 100}>
              <div class="w-full h-full bg-neutral-800 group-hover:scale-110 transition-transform duration-500"></div>
            </div>
          ))}
        </div>
        <div class="text-center">
          <a href="/works/" class="inline-block px-8 py-3 bg-neutral-800 text-white text-xs font-bold hover:bg-neutral-900 hover:scale-105 active:scale-95 transition-all duration-200 shadow-md">
            詳しく見る
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. 3バナーセクション -->
  <section class="bg-neutral-900 text-white py-16 px-4 overflow-hidden">
    <div class="max-w-6xl mx-auto grid md:grid-cols-3 gap-6 text-center">
      {[1, 2, 3].map((_, idx) => (
        <div class="border border-neutral-700 p-8 hover:border-white transition-all duration-300 cursor-pointer transform hover:-translate-y-1 hover:shadow-lg" data-animate="fade-up" data-delay={idx * 150}>
          <h3 class="text-xl font-bold mb-1">セクション</h3>
          <p class="text-xs text-neutral-400 tracking-widest">SECTION</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 8. カルーセル風セクション -->
  <section class="py-20 px-4 overflow-hidden">
    <div class="text-center mb-12" data-animate="fade-up">
      <h2 class="text-3xl font-bold text-neutral-800 mb-1">セクション</h2>
      <p class="text-xs text-neutral-400 uppercase tracking-widest">SECTION</p>
    </div>

    <div class="flex gap-6 max-w-6xl mx-auto items-center justify-center flex-wrap md:flex-nowrap">
      {[1, 2, 3].map((_, idx) => (
        <div class="w-full md:w-80 flex-shrink-0 space-y-3 group cursor-pointer" data-animate="fade-up" data-delay={idx * 150}>
          <div class="aspect-[4/3] bg-neutral-800 overflow-hidden rounded-sm shadow-sm">
            <div class="w-full h-full bg-neutral-800 group-hover:scale-105 transition-transform duration-500"></div>
          </div>
          <p class="text-xs text-neutral-700 font-medium group-hover:text-neutral-900 transition">タイトルが入ります。タイトルが入ります。</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 9. お問い合わせ誘導 -->
  <section class="py-20 bg-neutral-50 border-t border-neutral-200 text-center px-4 overflow-hidden">
    <div class="max-w-3xl mx-auto space-y-6" data-animate="fade-up">
      <h2 class="text-3xl font-bold text-neutral-800 mb-1">セクション</h2>
      <p class="text-xs text-neutral-400 uppercase tracking-widest">SECTION</p>
      <p class="text-sm text-neutral-600 leading-relaxed">
        これはダミーテキストです。本文が入ります。これはダミーテキストです。本文が入ります。
      </p>

      <div class="grid sm:grid-cols-2 gap-6 pt-6">
        <a href="/contact/" class="bg-white p-6 border border-neutral-300 hover:border-neutral-800 transition-all duration-200 transform hover:-translate-y-1 shadow-sm hover:shadow-md block">
          <p class="font-bold text-sm text-neutral-800 mb-1">メールでのお問い合わせ</p>
          <p class="text-xs text-neutral-500">お気軽にお問い合わせください</p>
        </a>
        <div class="bg-white p-6 border border-neutral-300 shadow-sm">
          <p class="font-bold text-lg text-neutral-800 tracking-wider mb-1">00-0000-0000</p>
          <p class="text-xs text-neutral-500">お電話でのお問い合わせはこちら</p>
        </div>
      </div>
    </div>
  </section>

</Layout>


