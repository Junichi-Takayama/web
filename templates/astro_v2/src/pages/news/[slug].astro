---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/common/PageHeader.astro';
import { getNewsList, getNewsDetail, type NewsItem } from '../../lib/microcms';

export async function getStaticPaths() {
  const newsList = await getNewsList();
  return newsList.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

interface Props {
  item: NewsItem;
}

const { item } = Astro.props;
// 詳細APIを叩くか、propsのデータを使用（propsにcontentがあるためそのまま活用可能）
const post = item.content ? item : ((await getNewsDetail(item.id)) || item);
---

<Layout title={`${post.title} | お知らせ | ArCraft（アルクラフト）`}>
  <PageHeader 
    title="NEWS DETAIL" 
    subTitle="Information & Releases"
  />

  <section class="py-20 px-6 max-w-3xl mx-auto space-y-10">
    <div class="border-b border-stone-200 pb-6 space-y-3" data-animate="fade-up">
      <div class="flex items-center gap-3 text-xs">
        <span class="text-stone-400 font-mono text-[11px]">{post.date}</span>
        <span class="px-2.5 py-0.5 bg-stone-900 text-white text-[10px] font-medium tracking-wider">
          {post.category}
        </span>
      </div>
      <h1 class="font-serif-title text-2xl md:text-3xl font-medium text-stone-900 leading-snug">
        {post.title}
      </h1>
    </div>

    <div class="text-xs md:text-sm text-stone-600 leading-loose space-y-6 font-light" data-animate="fade-up">
      {post.thumbnail && (
        <div class="aspect-[16/9] overflow-hidden rounded-sm bg-stone-200 mb-6">
          <img 
            src={post.thumbnail.url} 
            alt={post.title} 
            class="w-full h-full object-cover"
          />
        </div>
      )}

      <!-- 本文（リッチエディタHTMLレンダリング） -->
      <div class="space-y-4 prose prose-stone max-w-none text-xs md:text-sm text-stone-600 leading-relaxed font-light" set:html={post.content} />
    </div>

    <div class="pt-8 border-t border-stone-200 flex justify-between items-center">
      <a href="/news/" class="inline-flex items-center gap-2 px-6 py-2.5 bg-stone-100 hover:bg-stone-200 text-stone-800 text-xs tracking-wider transition">
        <span>&larr;</span>
        <span>お知らせ一覧に戻る</span>
      </a>
      <a href="/contact/" class="inline-flex items-center gap-2 px-6 py-2.5 bg-stone-900 hover:bg-stone-800 text-white text-xs tracking-wider transition shadow-sm">
        <span>お問い合わせ</span>
        <span>&rarr;</span>
      </a>
    </div>
  </section>
</Layout>



