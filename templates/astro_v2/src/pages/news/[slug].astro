---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/common/PageHeader.astro';
import { getNewsList, getNewsDetail, type NewsItem } from '../../lib/microcms';

export async function getStaticPaths() {
  const newsList = await getNewsList();
  return newsList.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

interface Props {
  item: NewsItem;
}

const { item } = Astro.props;
// 詳細APIを叩くか、propsのデータを使用（propsにcontentがあるためそのまま活用可能）
const post = item.content ? item : ((await getNewsDetail(item.id)) || item);
---

<Layout title={`${post.title} | お知らせ | ArCraft（アルクラフト）`}>
  <PageHeader 
    title="NEWS DETAIL" 
    subTitle="Information & Releases"
  />

  <section class="py-20 px-6 max-w-3xl mx-auto space-y-10">
    <div class="border-b border-stone-200 pb-6 space-y-3" data-animate="fade-up">
      <div class="flex items-center gap-3 text-xs">
        <span class="text-stone-400 font-mono text-[11px]">{post.date}</span>
        <span class="px-2.5 py-0.5 bg-stone-900 text-white text-[10px] font-medium tracking-wider">
          {post.category}
        </span>
      </div>
      <h1 class="font-serif-title text-2xl md:text-3xl font-medium text-stone-900 leading-snug">
        {post.title}
      </h1>
    </div>

    <div class="text-xs md:text-sm text-stone-600 leading-loose space-y-6 font-light" data-animate="fade-up">
      {post.thumbnail && (
        <div class="aspect-[16/9] overflow-hidden rounded-sm bg-stone-200 mb-6">
          <img 
            src={post.thumbnail.url} 
            alt={post.title} 
            class="w-full h-full object-cover"
          />
        </div>
      )}

      <!-- 本文（リッチエディタHTMLレンダリング） -->
      <div 
        class="prose prose-stone prose-sm md:prose-base max-w-none font-light leading-relaxed prose-headings:font-serif-title prose-headings:font-normal prose-headings:text-stone-900 prose-h2:text-xl md:prose-h2:text-2xl prose-h2:border-b prose-h2:border-stone-200 prose-h2:pb-3 prose-h2:mt-10 prose-h3:text-lg md:prose-h3:text-xl prose-h3:mt-8 prose-h4:text-base prose-h5:text-sm prose-p:text-stone-600 prose-p:leading-loose prose-ul:list-disc prose-ol:list-decimal prose-table:w-full prose-table:border prose-table:border-stone-200 prose-th:border prose-th:border-stone-200 prose-th:bg-stone-100 prose-th:p-2.5 prose-th:text-xs prose-th:font-medium prose-td:border prose-td:border-stone-200 prose-td:p-2.5 prose-td:text-xs prose-blockquote:border-l-2 prose-blockquote:border-stone-400 prose-blockquote:bg-stone-50/70 prose-blockquote:py-2 prose-blockquote:px-4 prose-blockquote:not-italic prose-pre:bg-stone-900 prose-pre:text-stone-100 prose-pre:rounded-sm" 
        set:html={post.content} 
      />
    </div>

    <div class="pt-8 border-t border-stone-200 flex justify-between items-center">
      <a href="/news/" class="inline-flex items-center gap-2 px-6 py-2.5 bg-stone-100 hover:bg-stone-200 text-stone-800 text-xs tracking-wider transition">
        <span>&larr;</span>
        <span>お知らせ一覧に戻る</span>
      </a>
      <a href="/contact/" class="inline-flex items-center gap-2 px-6 py-2.5 bg-stone-900 hover:bg-stone-800 text-white text-xs tracking-wider transition shadow-sm">
        <span>お問い合わせ</span>
        <span>&rarr;</span>
      </a>
    </div>
  </section>
</Layout>



