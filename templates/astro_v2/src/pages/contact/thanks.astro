---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/common/PageHeader.astro';
---

<Layout title="無料診断お申し込み完了 | ArCraft（アルクラフト）">
  <PageHeader 
    title="THANK YOU" 
    subTitle="Diagnosis Request Sent Successfully"
  />

  <section class="py-24 px-6 max-w-xl mx-auto text-center space-y-6" data-animate="fade-up">
    <div class="w-16 h-16 bg-stone-100 rounded-full flex items-center justify-center mx-auto text-stone-800 text-2xl font-bold">
      ✓
    </div>
    <h2 class="font-serif-title text-2xl font-medium text-stone-900">無料診断のお申し込みありがとうございます</h2>
    <p class="text-xs md:text-sm text-stone-600 leading-relaxed font-light">
      ご入力いただいた内容を安全に受領いたしました。<br />
      現行Webサイトの表示速度・セキュリティ等の客観的な診断レポートを作成し、<br class="hidden sm:inline" />
      担当ディレクターより2営業日以内にご連絡させていただきます。
    </p>
    <div class="pt-6">
      <a href="/" class="inline-block px-8 py-3 bg-stone-900 text-white text-xs tracking-widest uppercase font-medium hover:bg-stone-800 transition shadow-sm">
        トップページへ戻る
      </a>
    </div>
  </section>
</Layout>

