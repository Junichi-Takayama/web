---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/common/PageHeader.astro';
---

<Layout title="無料相談・お問い合わせ | ARCH CRAFT STUDIO">
  <PageHeader 
    title="CONTACT" 
    subTitle="Consultation & Inquiries"
    bgImage="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1920&q=80"
  />

  <section class="py-24 px-6 max-w-4xl mx-auto space-y-20">
    <!-- お電話でのお問い合わせ -->
    <div class="text-center space-y-3 bg-stone-100/70 p-8 rounded-sm border border-stone-200" data-animate="fade-up">
      <span class="font-en-serif text-xs text-stone-400 tracking-[0.3em] uppercase block">Telephone</span>
      <h2 class="font-serif-title text-xl font-medium text-stone-900">お電話でのお問い合わせ</h2>
      <p class="font-mono text-3xl md:text-4xl font-bold text-stone-900 tracking-wider">03-6400-0000</p>
      <p class="text-xs text-stone-500 font-light">受付時間 10:00〜18:00（水曜定休）</p>
    </div>

    <!-- メールフォームでお問い合わせ -->
    <div class="space-y-8" data-animate="fade-up">
      <div class="text-center space-y-2">
        <span class="font-en-serif text-xs text-stone-400 tracking-[0.3em] uppercase block">Web Form</span>
        <h2 class="font-serif-title text-2xl font-medium text-stone-900">ご相談・お問い合わせフォーム</h2>
        <p class="text-xs text-stone-500 font-light max-w-md mx-auto leading-relaxed">
          建築設計・リノベーション・土地探しのご相談など、専任の一級建築士が丁寧にお応えします。2営業日以内に担当よりご連絡いたします。
        </p>
      </div>

      <div class="bg-white p-8 md:p-12 rounded-sm border border-stone-200 shadow-sm">
        <form action="/contact/thanks" method="GET" class="space-y-6 text-xs">
          <div class="grid grid-cols-1 md:grid-cols-4 gap-2 items-center border-b border-stone-200 pb-4">
            <label class="font-medium text-stone-800 md:col-span-1">ご相談内容 <span class="text-red-500 text-[10px]">*</span></label>
            <div class="md:col-span-3 flex flex-wrap gap-4 text-stone-700">
              <label class="inline-flex items-center gap-2"><input type="checkbox" name="type" value="new" /> 注文住宅の新築</label>
              <label class="inline-flex items-center gap-2"><input type="checkbox" name="type" value="reno" /> リノベーション</label>
              <label class="inline-flex items-center gap-2"><input type="checkbox" name="type" value="villa" /> 別荘・セカンドハウス</label>
              <label class="inline-flex items-center gap-2"><input type="checkbox" name="type" value="other" /> その他</label>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-4 gap-2 items-center border-b border-stone-200 pb-4">
            <label class="font-medium text-stone-800 md:col-span-1">お名前 <span class="text-red-500 text-[10px]">*</span></label>
            <input type="text" required placeholder="山田 太郎" class="md:col-span-3 w-full p-3 border border-stone-300 bg-stone-50/50 rounded-sm focus:outline-none focus:border-stone-800 transition" />
          </div>

          <div class="grid grid-cols-1 md:grid-cols-4 gap-2 items-center border-b border-stone-200 pb-4">
            <label class="font-medium text-stone-800 md:col-span-1">電話番号 <span class="text-red-500 text-[10px]">*</span></label>
            <input type="tel" required placeholder="090-0000-0000" class="md:col-span-3 w-full p-3 border border-stone-300 bg-stone-50/50 rounded-sm focus:outline-none focus:border-stone-800 transition" />
          </div>

          <div class="grid grid-cols-1 md:grid-cols-4 gap-2 items-center border-b border-stone-200 pb-4">
            <label class="font-medium text-stone-800 md:col-span-1">メールアドレス <span class="text-red-500 text-[10px]">*</span></label>
            <input type="email" required placeholder="name@example.com" class="md:col-span-3 w-full p-3 border border-stone-300 bg-stone-50/50 rounded-sm focus:outline-none focus:border-stone-800 transition" />
          </div>

          <div class="grid grid-cols-1 md:grid-cols-4 gap-2 items-start pt-2">
            <label class="font-medium text-stone-800 md:col-span-1 pt-2">ご相談・ご要望 <span class="text-red-500 text-[10px]">*</span></label>
            <textarea rows="5" required placeholder="ご計画の時期やご希望のエリア、ご質問などをご自由にご記入ください。" class="md:col-span-3 w-full p-3 border border-stone-300 bg-stone-50/50 rounded-sm focus:outline-none focus:border-stone-800 transition"></textarea>
          </div>

          <div class="text-center pt-8">
            <button type="submit" class="px-14 py-4 bg-stone-900 text-white font-medium text-xs hover:bg-stone-800 transition tracking-[0.2em] uppercase shadow-md hover:scale-105 active:scale-95 duration-200">
              送信する
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>
</Layout>


