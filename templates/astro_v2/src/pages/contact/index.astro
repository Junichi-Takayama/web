---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/common/PageHeader.astro';
---

<Layout title="Webサイト無料診断・ご相談 | ArCraft（アルクラフト）">
  <PageHeader 
    title="CONTACT & AUDIT" 
    subTitle="Free Website Diagnosis & Consultation"
    bgImage="https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=1920&q=80"
  />

  <section class="py-24 px-6 max-w-4xl mx-auto space-y-16">
    <!-- 案内文 -->
    <div class="text-center space-y-3 bg-stone-100 p-8 rounded-sm border border-stone-200" data-animate="fade-up">
      <span class="font-en-serif text-xs text-stone-500 tracking-[0.3em] uppercase block">Free Diagnosis</span>
      <h2 class="font-serif-title text-xl md:text-2xl font-medium text-stone-900">
        まずは貴社Webサイトの「客観的な現状診断」から
      </h2>
      <p class="text-xs text-stone-600 leading-relaxed font-light max-w-2xl mx-auto">
        「表示速度」「スマートフォンでの快適性」「サーバーの安全性（放置リスクの有無）」をプロが診断し、客観的な数値レポートを添えてご回答します。強引な営業は一切行いませんので安心してお申し込みください。
      </p>
    </div>

    <!-- メールフォーム -->
    <div class="space-y-8" data-animate="fade-up">
      <div class="bg-white p-8 md:p-12 rounded-sm border border-stone-200 shadow-sm">
        <form action="/contact/thanks" method="GET" class="space-y-6 text-xs">
          <!-- ご相談種別 -->
          <div class="grid grid-cols-1 md:grid-cols-4 gap-2 items-center border-b border-stone-200 pb-4">
            <label class="font-medium text-stone-800 md:col-span-1">ご相談項目 <span class="text-red-500 text-[10px]">*</span></label>
            <div class="md:col-span-3 flex flex-wrap gap-4 text-stone-700">
              <label class="inline-flex items-center gap-2"><input type="checkbox" name="type" value="audit" checked /> Webサイト無料診断</label>
              <label class="inline-flex items-center gap-2"><input type="checkbox" name="type" value="engine" /> Webエンジン換装相談</label>
              <label class="inline-flex items-center gap-2"><input type="checkbox" name="type" value="partner" /> 月次伴走サポートについて</label>
              <label class="inline-flex items-center gap-2"><input type="checkbox" name="type" value="other" /> その他ご質問</label>
            </div>
          </div>

          <!-- 貴社名 -->
          <div class="grid grid-cols-1 md:grid-cols-4 gap-2 items-center border-b border-stone-200 pb-4">
            <label class="font-medium text-stone-800 md:col-span-1">貴社名 / 屋号 <span class="text-red-500 text-[10px]">*</span></label>
            <input type="text" required placeholder="例：株式会社〇〇工務店" class="md:col-span-3 w-full p-3 border border-stone-300 bg-stone-50/50 rounded-sm focus:outline-none focus:border-stone-800 transition" />
          </div>

          <!-- ご担当者名 -->
          <div class="grid grid-cols-1 md:grid-cols-4 gap-2 items-center border-b border-stone-200 pb-4">
            <label class="font-medium text-stone-800 md:col-span-1">お名前 <span class="text-red-500 text-[10px]">*</span></label>
            <input type="text" required placeholder="山田 太郎" class="md:col-span-3 w-full p-3 border border-stone-300 bg-stone-50/50 rounded-sm focus:outline-none focus:border-stone-800 transition" />
          </div>

          <!-- 現行WebサイトURL -->
          <div class="grid grid-cols-1 md:grid-cols-4 gap-2 items-center border-b border-stone-200 pb-4">
            <label class="font-medium text-stone-800 md:col-span-1">現行WebサイトURL</label>
            <input type="url" placeholder="https://example.com" class="md:col-span-3 w-full p-3 border border-stone-300 bg-stone-50/50 rounded-sm focus:outline-none focus:border-stone-800 transition" />
          </div>

          <!-- 電話番号 -->
          <div class="grid grid-cols-1 md:grid-cols-4 gap-2 items-center border-b border-stone-200 pb-4">
            <label class="font-medium text-stone-800 md:col-span-1">電話番号 <span class="text-red-500 text-[10px]">*</span></label>
            <input type="tel" required placeholder="090-0000-0000" class="md:col-span-3 w-full p-3 border border-stone-300 bg-stone-50/50 rounded-sm focus:outline-none focus:border-stone-800 transition" />
          </div>

          <!-- メールアドレス -->
          <div class="grid grid-cols-1 md:grid-cols-4 gap-2 items-center border-b border-stone-200 pb-4">
            <label class="font-medium text-stone-800 md:col-span-1">メールアドレス <span class="text-red-500 text-[10px]">*</span></label>
            <input type="email" required placeholder="name@example.com" class="md:col-span-3 w-full p-3 border border-stone-300 bg-stone-50/50 rounded-sm focus:outline-none focus:border-stone-800 transition" />
          </div>

          <!-- ご相談内容 -->
          <div class="grid grid-cols-1 md:grid-cols-4 gap-2 items-start pt-2">
            <label class="font-medium text-stone-800 md:col-span-1 pt-2">現在のお困りごと <span class="text-red-500 text-[10px]">*</span></label>
            <textarea rows="5" required placeholder="「WordPressの更新が止まっている」「スマホ表示が遅い」「リニューアル費用を抑えたい」など、現状のお悩みを率直にお聞かせください。" class="md:col-span-3 w-full p-3 border border-stone-300 bg-stone-50/50 rounded-sm focus:outline-none focus:border-stone-800 transition"></textarea>
          </div>

          <div class="text-center pt-8">
            <button type="submit" class="px-14 py-4 bg-stone-900 text-white font-medium text-xs hover:bg-stone-800 transition tracking-[0.2em] uppercase shadow-md hover:scale-105 active:scale-95 duration-200">
              無料診断を送信する
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>
</Layout>



