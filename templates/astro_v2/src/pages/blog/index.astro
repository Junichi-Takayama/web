---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/common/PageHeader.astro';

const blogPosts = [
  {
    date: "2026.09.02",
    category: "現場レポート",
    title: "無垢オーク材と大谷石のコントラスト。鎌倉の現場より",
    image: "https://images.unsplash.com/photo-1600585154526-990dced4db0d?auto=format&fit=crop&w=600&q=80",
    slug: "sample-post"
  },
  {
    date: "2026.08.20",
    category: "デザイン思想",
    title: "「陰影を愉しむ」日本の美意識を宿した照明計画について",
    image: "https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=600&q=80",
    slug: "sample-post"
  },
  {
    date: "2026.08.05",
    category: "リノベーション",
    title: "築45年のヴィンテージマンションをスケルトンから再構築する",
    image: "https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=600&q=80",
    slug: "sample-post"
  },
  {
    date: "2026.07.18",
    category: "素材の選び方",
    title: "経年美化を愉しむ、無垢材オイルフィニッシュのメンテナンス",
    image: "https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=600&q=80",
    slug: "sample-post"
  },
  {
    date: "2026.07.02",
    category: "パッシブ設計",
    title: "夏涼しく冬暖かい家をつくる「軒の出（のきので）」の計算",
    image: "https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=600&q=80",
    slug: "sample-post"
  },
  {
    date: "2026.06.14",
    category: "造作家具",
    title: "空間に溶け込むキッチン。大工と建具職人の手仕事",
    image: "https://images.unsplash.com/photo-1555041469-a586c61ea9bc?auto=format&fit=crop&w=600&q=80",
    slug: "sample-post"
  }
];
---

<Layout title="建築日誌・コラム | ARCH CRAFT STUDIO">
  <PageHeader 
    title="JOURNAL" 
    subTitle="Architect's Notes & Insights"
    bgImage="https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=1920&q=80"
  />

  <section class="py-24 px-6 max-w-6xl mx-auto">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-16" data-animate="fade-up">
      {blogPosts.map((post) => (
        <article class="space-y-3 group">
          <a href={`/blog/${post.slug}/`} class="aspect-[4/3] bg-stone-200 block overflow-hidden rounded-sm shadow-sm relative">
            <img 
              src={post.image} 
              alt={post.title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
            />
          </a>
          <div class="flex items-center gap-3 text-xs">
            <span class="text-stone-400 font-mono text-[11px]">{post.date}</span>
            <span class="px-2 py-0.5 bg-stone-100 text-stone-700 text-[10px] font-medium tracking-wider">
              {post.category}
            </span>
          </div>
          <h2 class="font-serif-title font-medium text-sm text-stone-900 leading-snug group-hover:text-stone-600 transition">
            <a href={`/blog/${post.slug}/`}>
              {post.title}
            </a>
          </h2>
        </article>
      ))}
    </div>

    <!-- ページネーション -->
    <div class="flex items-center justify-center gap-2 text-xs font-mono">
      <span class="w-10 h-10 bg-stone-900 text-white flex items-center justify-center font-bold">1</span>
      <a href="#" class="w-10 h-10 border border-stone-300 flex items-center justify-center hover:bg-stone-100 transition">2</a>
    </div>
  </section>
</Layout>

