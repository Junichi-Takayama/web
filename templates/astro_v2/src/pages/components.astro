---
import Layout from '../layouts/Layout.astro';

// 1. Navigation
import HeaderNav from '../components/catalog/navigation/HeaderNav.astro';
import MegaMenu from '../components/catalog/navigation/MegaMenu.astro';
import FooterDefault from '../components/catalog/navigation/FooterDefault.astro';

// 2. Hero
import HeroCentered from '../components/catalog/hero/HeroCentered.astro';
import HeroSplit from '../components/catalog/hero/HeroSplit.astro';
import HeroMinimal from '../components/catalog/hero/HeroMinimal.astro';

// 3. Features & Problems
import ProblemCards from '../components/catalog/features/ProblemCards.astro';
import FeatureGrid from '../components/catalog/features/FeatureGrid.astro';
import AlternatingRows from '../components/catalog/features/AlternatingRows.astro';
import KeyBenefits from '../components/catalog/features/KeyBenefits.astro';

// 4. Pricing & Comparison
import PricingCards from '../components/catalog/pricing/PricingCards.astro';
import ComparisonTable from '../components/catalog/pricing/ComparisonTable.astro';
import FeatureChecklist from '../components/catalog/pricing/FeatureChecklist.astro';

// 5. Cases & Gallery
import CaseStudies from '../components/catalog/cases/CaseStudies.astro';
import BentoGrid from '../components/catalog/cases/BentoGrid.astro';
import ImageGallery from '../components/catalog/cases/ImageGallery.astro';

// 6. Trust & About
import ProfileMessage from '../components/catalog/trust/ProfileMessage.astro';
import TimelineHistory from '../components/catalog/trust/TimelineHistory.astro';
import StatCounters from '../components/catalog/trust/StatCounters.astro';

// 7. Content & FAQ
import AccordionFAQ from '../components/catalog/content/AccordionFAQ.astro';
import TabbedContent from '../components/catalog/content/TabbedContent.astro';
import ProcessSteps from '../components/catalog/content/ProcessSteps.astro';

// 8. CTA & Forms
import LeadCTA from '../components/catalog/cta/LeadCTA.astro';
import ContactForm from '../components/catalog/cta/ContactForm.astro';
import FloatingCTA from '../components/catalog/cta/FloatingCTA.astro';
---

<Layout 
  title="汎用共通25種 UIコンポーネントカタログ | ArCraft"
  description="地方工務店・中小企業向けWeb制作に特化した、高再利用性・超高速Astroコンポーネント群（全25種）のインタラクティブカタログです。用途や活用シーンの解説付き。"
>
  <!-- ヒーローセクション -->
  <section class="py-20 px-6 bg-stone-900 text-white border-b border-stone-800">
    <div class="max-w-6xl mx-auto space-y-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-stone-800 border border-stone-700 text-[11px] font-mono uppercase tracking-widest text-stone-300">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        ArCraft Component Library (25 Components)
      </div>
      <h1 class="font-serif-title text-3xl md:text-5xl font-medium tracking-wider">
        汎用共通25種 UIコンポーネントカタログ
      </h1>
      <p class="text-stone-400 text-xs md:text-sm max-w-3xl font-light leading-relaxed">
        地方工務店・中小企業案件のあらゆる要求に応える、TypeScript完全対応・Tailwind CSS統合済みの高再利用性コンポーネント群です。各パーツの名称やタグをワンクリックでコピーでき、用途・推奨シーンを確認しながらスムーズにサイト設計・実装へ転用いただけます。
      </p>

      <div class="flex flex-wrap gap-2 text-xs font-mono pt-4">
        <a href="#cat-nav" class="px-3 py-1.5 bg-stone-800 hover:bg-stone-700 hover:text-white hover:-translate-y-0.5 hover:shadow-xs text-stone-200 border border-stone-700 hover:border-stone-500 transition-all duration-150">01. Navigation (3)</a>
        <a href="#cat-hero" class="px-3 py-1.5 bg-stone-800 hover:bg-stone-700 hover:text-white hover:-translate-y-0.5 hover:shadow-xs text-stone-200 border border-stone-700 hover:border-stone-500 transition-all duration-150">02. Hero (3)</a>
        <a href="#cat-features" class="px-3 py-1.5 bg-stone-800 hover:bg-stone-700 hover:text-white hover:-translate-y-0.5 hover:shadow-xs text-stone-200 border border-stone-700 hover:border-stone-500 transition-all duration-150">03. Features (4)</a>
        <a href="#cat-pricing" class="px-3 py-1.5 bg-stone-800 hover:bg-stone-700 hover:text-white hover:-translate-y-0.5 hover:shadow-xs text-stone-200 border border-stone-700 hover:border-stone-500 transition-all duration-150">04. Pricing (3)</a>
        <a href="#cat-cases" class="px-3 py-1.5 bg-stone-800 hover:bg-stone-700 hover:text-white hover:-translate-y-0.5 hover:shadow-xs text-stone-200 border border-stone-700 hover:border-stone-500 transition-all duration-150">05. Cases (3)</a>
        <a href="#cat-trust" class="px-3 py-1.5 bg-stone-800 hover:bg-stone-700 hover:text-white hover:-translate-y-0.5 hover:shadow-xs text-stone-200 border border-stone-700 hover:border-stone-500 transition-all duration-150">06. Trust (3)</a>
        <a href="#cat-content" class="px-3 py-1.5 bg-stone-800 hover:bg-stone-700 hover:text-white hover:-translate-y-0.5 hover:shadow-xs text-stone-200 border border-stone-700 hover:border-stone-500 transition-all duration-150">07. Content (3)</a>
        <a href="#cat-cta" class="px-3 py-1.5 bg-stone-800 hover:bg-stone-700 hover:text-white hover:-translate-y-0.5 hover:shadow-xs text-stone-200 border border-stone-700 hover:border-stone-500 transition-all duration-150">08. CTA & Form (3)</a>
      </div>
    </div>
  </section>

  <!-- 01. NAVIGATION -->
  <section id="cat-nav" class="py-20 bg-stone-50 border-b border-stone-200 scroll-mt-12">
    <div class="max-w-7xl mx-auto px-6 space-y-12">
      <div class="border-b border-stone-300 pb-3">
        <span class="text-xs font-mono tracking-widest text-stone-400 uppercase">Category 01</span>
        <h2 class="font-serif-title text-2xl font-bold text-stone-900 mt-1">ナビゲーション・ヘッダー系 (3種)</h2>
      </div>

      <!-- #01 HeaderNav -->
      <div class="space-y-4">
        <div class="bg-stone-200/70 border border-stone-300 border-l-4 border-l-stone-900 p-5 rounded-r-sm shadow-xs">
          <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-stone-300/80">
            <div class="flex items-center gap-2.5">
              <span class="text-xs font-mono font-bold px-2 py-0.5 bg-stone-900 text-white rounded-xs">#01</span>
              <h3 class="font-mono text-base font-bold text-stone-900">HeaderNav.astro</h3>
              <button 
                type="button" 
                class="copy-btn inline-flex items-center gap-1 px-2.5 py-1 text-xs font-mono text-stone-600 bg-white hover:bg-stone-900 shadow-2xs hover:text-white border border-stone-300 rounded-xs transition-colors"
                data-copy="HeaderNav.astro"
                title="ファイル名をコピー"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span class="copy-text">名称コピー</span>
              </button>
            </div>
            <button 
              type="button" 
              class="copy-btn inline-flex items-center gap-1.5 px-3 py-1 text-xs font-mono text-stone-700 bg-white hover:bg-stone-900 shadow-2xs hover:text-white border border-stone-300 rounded-xs transition-colors"
              data-copy={'<HeaderNav brandName="ArCraft" brandSub="Architecture Engine" />'}
              title="タグをコピー"
            >
              <span class="copy-text">&lt;HeaderNav /&gt; タグコピー</span>
            </button>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs text-stone-600 pt-3">
            <div class="space-y-1">
              <span class="font-bold text-stone-900 flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-stone-400"></span>コンポーネント概要
              </span>
              <p class="text-stone-600 leading-relaxed pl-3">
                ブランドロゴ、主要ナビリンク（デスクトップ横並び）、およびスマホ用ハンバーガーメニュー開閉を備えたレスポンシブ共通ヘッダー。
              </p>
            </div>
            <div class="space-y-1">
              <span class="font-bold text-stone-900 flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span>主な用途・推奨シーン
              </span>
              <p class="text-stone-600 leading-relaxed pl-3">
                あらゆるコーポレートサイト、工務店サイト、サービスサイトの基本グローバルナビゲーション。ページ共通テンプレート（Layout）に配置。
              </p>
            </div>
          </div>
        </div>
        <div class="text-[11px] font-mono font-bold text-stone-400 uppercase tracking-widest flex items-center gap-1.5 pl-1 pt-1">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          実動プレビュー (Live Component)
        </div>
        <div class="border border-stone-200 rounded-sm overflow-hidden bg-stone-50 p-2">
          <HeaderNav brandName="ArCraft" brandSub="Architecture Engine" />
        </div>
      </div>
      <!-- #02 MegaMenu -->
      <div class="space-y-4">
        <div class="bg-stone-200/70 border border-stone-300 border-l-4 border-l-stone-900 p-5 rounded-r-sm shadow-xs">
          <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-stone-300/80">
            <div class="flex items-center gap-2.5">
              <span class="text-xs font-mono font-bold px-2 py-0.5 bg-stone-900 text-white rounded-xs">#02</span>
              <h3 class="font-mono text-base font-bold text-stone-900">MegaMenu.astro</h3>
              <button 
                type="button" 
                class="copy-btn inline-flex items-center gap-1 px-2.5 py-1 text-xs font-mono text-stone-600 bg-white hover:bg-stone-900 shadow-2xs hover:text-white border border-stone-300 rounded-xs transition-colors"
                data-copy="MegaMenu.astro"
                title="ファイル名をコピー"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span class="copy-text">名称コピー</span>
              </button>
            </div>
            <button 
              type="button" 
              class="copy-btn inline-flex items-center gap-1.5 px-3 py-1 text-xs font-mono text-stone-700 bg-white hover:bg-stone-900 shadow-2xs hover:text-white border border-stone-300 rounded-xs transition-colors"
              data-copy="<MegaMenu />"
              title="タグをコピー"
            >
              <span class="copy-text">&lt;MegaMenu /&gt; タグコピー</span>
            </button>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs text-stone-600 pt-3">
            <div class="space-y-1">
              <span class="font-bold text-stone-900 flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-stone-400"></span>コンポーネント概要
              </span>
              <p class="text-stone-600 leading-relaxed pl-3">
                ホバーやクリックで広がる多階層ナビゲーション。事業内容、施工カテゴリ、会社案内を特集バナー枠付きで一望できる大容量メニュー。
              </p>
            </div>
            <div class="space-y-1">
              <span class="font-bold text-stone-900 flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span>主な用途・推奨シーン
              </span>
              <p class="text-stone-600 leading-relaxed pl-3">
                取扱事業や商品数が多い工務店（注文住宅/リフォーム/不動産）、製造業（製品一覧/技術紹介）、総合士業法人のヘッダー展開に最適。
              </p>
            </div>
          </div>
        </div>
        <div class="text-[11px] font-mono font-bold text-stone-400 uppercase tracking-widest flex items-center gap-1.5 pl-1 pt-1">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          実動プレビュー (Live Component)
        </div>
        <div class="border border-stone-200 rounded-sm overflow-hidden bg-stone-100 p-6">
          <MegaMenu />
        </div>
      </div>

      <!-- #03 FooterDefault -->
      <div class="space-y-4">
        <div class="bg-stone-200/70 border border-stone-300 border-l-4 border-l-stone-900 p-5 rounded-r-sm shadow-xs">
          <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-stone-300/80">
            <div class="flex items-center gap-2.5">
              <span class="text-xs font-mono font-bold px-2 py-0.5 bg-stone-900 text-white rounded-xs">#03</span>
              <h3 class="font-mono text-base font-bold text-stone-900">FooterDefault.astro</h3>
              <button 
                type="button" 
                class="copy-btn inline-flex items-center gap-1 px-2.5 py-1 text-xs font-mono text-stone-600 bg-white hover:bg-stone-900 shadow-2xs hover:text-white border border-stone-300 rounded-xs transition-colors"
                data-copy="FooterDefault.astro"
                title="ファイル名をコピー"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span class="copy-text">名称コピー</span>
              </button>
            </div>
            <button 
              type="button" 
              class="copy-btn inline-flex items-center gap-1.5 px-3 py-1 text-xs font-mono text-stone-700 bg-white hover:bg-stone-900 shadow-2xs hover:text-white border border-stone-300 rounded-xs transition-colors"
              data-copy={'<FooterDefault brandName="ArCraft Engine" />'}
              title="タグをコピー"
            >
              <span class="copy-text">&lt;FooterDefault /&gt; タグコピー</span>
            </button>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs text-stone-600 pt-3">
            <div class="space-y-1">
              <span class="font-bold text-stone-900 flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-stone-400"></span>コンポーネント概要
              </span>
              <p class="text-stone-600 leading-relaxed pl-3">
                会社概要、所在地、サイトマップ、各種ポリシーリンク、著作権表示を端正にグリッド配置した標準フッター。
              </p>
            </div>
            <div class="space-y-1">
              <span class="font-bold text-stone-900 flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span>主な用途・推奨シーン
              </span>
              <p class="text-stone-600 leading-relaxed pl-3">
                サイト全体の共通最下部。信頼性が求められる地域密着企業・中小企業の会社情報・許認可番号・SNSリンクの集約に最適。
              </p>
            </div>
          </div>
        </div>
        <div class="text-[11px] font-mono font-bold text-stone-400 uppercase tracking-widest flex items-center gap-1.5 pl-1 pt-1">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          実動プレビュー (Live Component)
        </div>
        <div class="border border-stone-200 rounded-sm overflow-hidden shadow-xs">
          <FooterDefault brandName="ArCraft Engine" />
        </div>
      </div>
    </div>
  </section>

  <!-- 02. HERO -->
  <section id="cat-hero" class="py-20 bg-white border-b border-stone-200 scroll-mt-12">
    <div class="max-w-7xl mx-auto px-6 space-y-12">
      <div class="border-b border-stone-300 pb-3">
        <span class="text-xs font-mono tracking-widest text-stone-400 uppercase">Category 02</span>
        <h2 class="font-serif-title text-2xl font-bold text-stone-900 mt-1">ヒーロー・ファーストビュー系 (3種)</h2>
      </div>

      <!-- #04 HeroCentered -->
      <div class="space-y-4">
        <div class="bg-stone-200/70 border border-stone-300 border-l-4 border-l-stone-900 p-5 rounded-r-sm shadow-xs">
          <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-stone-300/80">
            <div class="flex items-center gap-2.5">
              <span class="text-xs font-mono font-bold px-2 py-0.5 bg-stone-900 text-white rounded-xs">#04</span>
              <h3 class="font-mono text-base font-bold text-stone-900">HeroCentered.astro</h3>
              <button 
                type="button" 
                class="copy-btn inline-flex items-center gap-1 px-2.5 py-1 text-xs font-mono text-stone-600 bg-white hover:bg-stone-900 shadow-2xs hover:text-white border border-stone-300 rounded-xs transition-colors"
                data-copy="HeroCentered.astro"
                title="ファイル名をコピー"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                <span class="copy-text">名称コピー</span>
              </button>
            </div>
            <button 
              type="button" 
              class="copy-btn inline-flex items-center gap-1.5 px-3 py-1 text-xs font-mono text-stone-700 bg-white hover:bg-stone-900 shadow-2xs hover:text-white border border-stone-300 rounded-xs transition-colors"
              data-copy="<HeroCentered />"
              title="タグをコピー"
            >
              <span class="copy-text">&lt;HeroCentered /&gt; タグコピー</span>
            </button>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs text-stone-600 pt-3">
            <div class="space-y-1">
              <span class="font-bold text-stone-900 flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-stone-400"></span>コンポーネント概要
              </span>
              <p class="text-stone-600 leading-relaxed pl-3">
                実績バッジ、力強い中央揃えキャッチコピー、リード文、2連CTAボタンを配した王道のファーストビュー。
