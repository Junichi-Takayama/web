---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/common/PageHeader.astro';
---

<Layout title="404 Page Not Found | ArCraft（アルクラフト）" description="お探しのページは見つかりませんでした。">
  <PageHeader 
    title="404 NOT FOUND" 
    subTitle="Page Not Found"
  />

  <section class="py-24 px-6 max-w-3xl mx-auto text-center space-y-8">
    <div class="space-y-4">
      <p class="text-stone-800 font-serif-title text-xl md:text-2xl font-medium tracking-wide">
        お探しのページが見つかりませんでした
      </p>
      <p class="text-xs md:text-sm text-stone-500 leading-relaxed font-light">
        アクセスいただいたページは、移動または削除されたか、URLが正しくない可能性があります。<br class="hidden sm:inline" />
        トップページより再度お探しいただくか、メニューから各コンテンツをご覧ください。
      </p>
    </div>

    <div class="pt-6">
      <a 
        href="/" 
        class="inline-flex items-center justify-center px-8 py-4 bg-stone-900 text-stone-100 text-xs font-medium tracking-widest hover:bg-stone-800 transition-colors duration-300"
      >
        トップページへ戻る
      </a>
    </div>
  </section>
</Layout>
