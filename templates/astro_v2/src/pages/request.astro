---
// test/開発/root2/src/pages/request.astro
// 工務店専用・更新依頼＆コンテンツ入稿ポータル
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>コンテンツ入稿・更新依頼ポータル | 工務店サイト運用</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
  <style>
    body { font-family: 'Noto Sans JP', sans-serif; }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen pb-24">

  <!-- ヘッダー -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
    <div class="max-w-3xl mx-auto px-4 py-3 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-emerald-600 flex items-center justify-center text-white font-bold text-lg">
          🏠
        </div>
        <div>
          <h1 class="text-base font-bold text-slate-900 leading-tight">Webサイト更新依頼ポータル</h1>
          <p class="text-xs text-slate-500">写真自動軽量化 ＆ 入稿パッケージ生成ツール</p>
        </div>
      </div>
      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">
        ● オンライン
      </span>
    </div>
  </header>

  <!-- メインコンテンツ -->
  <main class="max-w-3xl mx-auto px-4 py-6">

    <!-- 案内バナー -->
    <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4 mb-6">
      <h2 class="text-sm font-bold text-emerald-900 flex items-center gap-1.5 mb-1">
        スマホ写真も容量オーバーなし！
      </h2>
      <p class="text-xs text-emerald-800 leading-relaxed">
        何枚写真をアップロードしても、ブラウザ内で自動的にWeb最適化サイズ（WebP）に軽量化されます。重い写真でも数秒で送信・パッケージ化できます。
      </p>
    </div>

    <!-- 種別切り替えタブ -->
    <div class="flex bg-slate-200 p-1 rounded-xl mb-6">
      <button type="button" id="tab-works" class="flex-1 py-2.5 text-xs sm:text-sm font-bold rounded-lg transition-all bg-white text-emerald-700 shadow-sm">
        🏡 施工事例の追加
      </button>
      <button type="button" id="tab-events" class="flex-1 py-2.5 text-xs sm:text-sm font-bold rounded-lg transition-all text-slate-600 hover:text-slate-900">
        🎪 イベント・見学会
      </button>
      <button type="button" id="tab-news" class="flex-1 py-2.5 text-xs sm:text-sm font-bold rounded-lg transition-all text-slate-600 hover:text-slate-900">
        📢 お知らせ投稿
      </button>
    </div>

    <form id="entry-form" class="space-y-6">
      <!-- ================= 施工事例用フィールド ================= -->
      <div id="works-fields" class="space-y-6">
        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm space-y-4">
          <h3 class="text-sm font-bold text-slate-900 pb-2 border-b border-slate-100 flex items-center justify-between">
            <span>施工事例 基本情報</span>
            <span class="text-xs text-rose-500 font-medium">※は必須</span>
          </h3>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">
              施工事例タイトル <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="work-title"
              placeholder="例: 光と風が通り抜ける中庭のある平屋"
              class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">カテゴリー</label>
              <select
                id="work-category"
                class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 bg-white"
              >
                <option value="新築住宅">新築住宅</option>
                <option value="リノベーション">リノベーション</option>
                <option value="店舗・商業施設">店舗・商業施設</option>
                <option value="その他">その他</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">施工エリア（市町村など）</label>
              <input
                type="text"
                id="work-city"
                placeholder="例: 横浜市青葉区"
                class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
              />
            </div>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">延床面積</label>
              <input
                type="text"
                id="work-floorspace"
                placeholder="例: 32.5坪"
                class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
              />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">家族構成</label>
              <input
                type="text"
                id="work-family"
                placeholder="例: ご夫婦＋子ども2人"
                class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
              />
            </div>
            <div class="col-span-2 sm:col-span-1">
              <label class="block text-xs font-bold text-slate-700 mb-1">工法・構造</label>
              <input
                type="text"
                id="work-structure"
                placeholder="例: 木造軸組工法"
                class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
              />
            </div>
          </div>

          <!-- タグ選択 -->
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5">タグ・特徴（タップして選択）</label>
            <div class="flex flex-wrap gap-2" id="preset-tags">
              <button type="button" class="tag-btn px-3 py-1 text-xs rounded-full border border-slate-300 bg-white hover:border-emerald-500 transition-colors" data-tag="平屋">平屋</button>
              <button type="button" class="tag-btn px-3 py-1 text-xs rounded-full border border-slate-300 bg-white hover:border-emerald-500 transition-colors" data-tag="中庭">中庭</button>
              <button type="button" class="tag-btn px-3 py-1 text-xs rounded-full border border-slate-300 bg-white hover:border-emerald-500 transition-colors" data-tag="吹抜け">吹抜け</button>
              <button type="button" class="tag-btn px-3 py-1 text-xs rounded-full border border-slate-300 bg-white hover:border-emerald-500 transition-colors" data-tag="高気密・高断熱">高気密・高断熱</button>
              <button type="button" class="tag-btn px-3 py-1 text-xs rounded-full border border-slate-300 bg-white hover:border-emerald-500 transition-colors" data-tag="自然素材">自然素材</button>
              <button type="button" class="tag-btn px-3 py-1 text-xs rounded-full border border-slate-300 bg-white hover:border-emerald-500 transition-colors" data-tag="ガレージハウス">ガレージハウス</button>
              <button type="button" class="tag-btn px-3 py-1 text-xs rounded-full border border-slate-300 bg-white hover:border-emerald-500 transition-colors" data-tag="家事ラク動線">家事ラク動線</button>
            </div>
          </div>

          <!-- 本文・こだわり -->
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">
              見どころ・施主様のこだわり・エピソード
            </label>
            <textarea
              id="work-body"
              rows="4"
              placeholder="リビングの大きな窓から中庭を望む開放的な空間づくり。キッチンは回遊動線を採用し、毎日の家事をスムーズにしました。"
              class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
            ></textarea>
          </div>
        </div>
      </div>
      <!-- ================= 見学会・イベント用フィールド ================= -->
      <div id="events-fields" class="space-y-6 hidden">
        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm space-y-4">
          <h3 class="text-sm font-bold text-slate-900 pb-2 border-b border-slate-100">イベント・見学会情報</h3>
          
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">イベントタイトル <span class="text-rose-500">*</span></label>
            <input type="text" id="event-title" placeholder="例: 【完成見学会】青葉区にて平屋の家 見学会開催！" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-sm focus:ring-2 focus:ring-emerald-500" />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">開催日時</label>
              <input type="text" id="event-date" placeholder="例: 2026年9月26日(土)・27日(日) 10:00〜17:00" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-sm" />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">開催場所</label>
              <input type="text" id="event-location" placeholder="例: 横浜市青葉区（ご予約確定後に詳細地図を送付）" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-sm" />
            </div>
          </div>

          <div class="flex items-center gap-4">
            <label class="flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-700">
              <input type="checkbox" id="event-reservation" checked class="w-4 h-4 text-emerald-600 rounded" />
              完全予約制
            </label>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">イベント詳細説明</label>
            <textarea id="event-body" rows="4" placeholder="見どころポイントや参加特典などを入力してください。" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-sm"></textarea>
          </div>
        </div>
      </div>

      <!-- ================= お知らせ用フィールド ================= -->
      <div id="news-fields" class="space-y-6 hidden">
        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm space-y-4">
          <h3 class="text-sm font-bold text-slate-900 pb-2 border-b border-slate-100">お知らせ内容</h3>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">お知らせタイトル <span class="text-rose-500">*</span></label>
            <input type="text" id="news-title" placeholder="例: 夏季休業のお知らせ（8/11〜8/16）" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-sm" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">お知らせ本文</label>
            <textarea id="news-body" rows="5" placeholder="平素は格別のお引き立てを賜り厚く御礼申し上げます..." class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-sm"></textarea>
          </div>
        </div>
      </div>
      <!-- ================= 写真リピーターエリア ================= -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm space-y-4">
        <div class="flex items-center justify-between pb-2 border-b border-slate-100">
          <div>
            <h3 class="text-sm font-bold text-slate-900">掲載写真アップロード</h3>
            <p class="text-xs text-slate-500">複数枚を一括選択できます（自動でWebPに軽量化）</p>
          </div>
          <span id="photo-count-badge" class="text-xs font-bold px-2 py-0.5 rounded-full bg-slate-100 text-slate-600">
            0 枚選択中
          </span>
        </div>

        <label for="photo-input" class="border-2 border-dashed border-slate-300 hover:border-emerald-500 rounded-xl p-6 text-center block cursor-pointer transition-colors bg-slate-50 hover:bg-emerald-50/50">
          <div class="text-3xl mb-1">📷</div>
          <span class="text-xs sm:text-sm font-bold text-emerald-700">写真を選択する（スマホの写真・アルバムから追加）</span>
          <p class="text-[11px] text-slate-500 mt-1">JPEG, PNG, HEICなど対応 / 1枚あたり自動で約150〜300KBに軽量化</p>
          <input type="file" id="photo-input" accept="image/*" multiple class="hidden" />
        </label>

        <div id="processing-indicator" class="hidden p-3 bg-emerald-50 border border-emerald-200 rounded-lg text-center">
          <div class="inline-flex items-center gap-2 text-xs font-bold text-emerald-800">
            <span class="text-sm">⏳</span>
            <span id="processing-text">写真をWebP形式へ最適化中...</span>
          </div>
        </div>

        <div id="photo-repeater-list" class="space-y-3"></div>

        <div id="compression-summary" class="hidden text-xs bg-slate-100 rounded-lg p-3 text-slate-700 flex justify-between items-center">
          <span>全体削減効果:</span>
          <span id="compression-stats" class="font-bold text-emerald-700"></span>
        </div>
      </div>

      <!-- ================= 出力アクション ================= -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm space-y-4">
        <h3 class="text-sm font-bold text-slate-900 pb-2 border-b border-slate-100">更新依頼の出力・ダウンロード</h3>

        <div class="space-y-3">
          <button
            type="button"
            id="btn-download-zip"
            class="w-full py-3.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:scale-[0.99] text-white font-bold text-sm shadow-md transition-all flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>📦 更新パッケージ (ZIP) を作成してダウンロード</span>
          </button>
          <p class="text-[11px] text-slate-500 text-center">
            最適化済みWebP画像 ＋ Markdownファイルが1つのZIPにまとまります。メールやLINEでそのまま送付できます。
          </p>
        </div>

        <div class="pt-3 border-t border-slate-100">
          <button
            type="button"
            id="btn-toggle-preview"
            class="text-xs text-slate-500 hover:text-slate-800 font-medium flex items-center gap-1 mx-auto cursor-pointer"
          >
            <span>生成されるMarkdownコードを確認する</span>
            <span id="preview-arrow">▼</span>
          </button>

          <div id="preview-container" class="hidden mt-3 space-y-2">
            <div class="flex justify-between items-center">
              <span class="text-[11px] font-mono text-slate-500" id="preview-filename">works/slug.md</span>
              <button
                type="button"
                id="btn-copy-markdown"
                class="px-2.5 py-1 text-xs rounded bg-slate-200 hover:bg-slate-300 text-slate-700 font-medium transition-colors cursor-pointer"
              >
                コピー
              </button>
            </div>
            <pre id="markdown-preview" class="p-3 bg-slate-900 text-emerald-400 font-mono text-xs rounded-lg overflow-x-auto max-h-60"></pre>
          </div>
        </div>
      </div>
    </form>
  </main>

  <script is:inline>
    // @ts-ignore
    const JSZip = window.JSZip;
    let currentTab = 'works';
    let uploadedImages = [];
    let selectedTags = [];

    const tabWorks = document.getElementById('tab-works');
    const tabEvents = document.getElementById('tab-events');
    const tabNews = document.getElementById('tab-news');
    const worksFields = document.getElementById('works-fields');
    const eventsFields = document.getElementById('events-fields');
    const newsFields = document.getElementById('news-fields');

    function switchTab(tab) {
      currentTab = tab;
      [tabWorks, tabEvents, tabNews].forEach(btn => {
        btn.classList.remove('bg-white', 'text-emerald-700', 'shadow-sm');
        btn.classList.add('text-slate-600');
      });

      worksFields.classList.add('hidden');
      eventsFields.classList.add('hidden');
      newsFields.classList.add('hidden');

      if (tab === 'works') {
        tabWorks.classList.add('bg-white', 'text-emerald-700', 'shadow-sm');
        tabWorks.classList.remove('text-slate-600');
        worksFields.classList.remove('hidden');
      } else if (tab === 'events') {
        tabEvents.classList.add('bg-white', 'text-emerald-700', 'shadow-sm');
        tabEvents.classList.remove('text-slate-600');
        eventsFields.classList.remove('hidden');
      } else if (tab === 'news') {
        tabNews.classList.add('bg-white', 'text-emerald-700', 'shadow-sm');
        tabNews.classList.remove('text-slate-600');
        newsFields.classList.remove('hidden');
      }
      updateMarkdownPreview();
    }

    tabWorks.addEventListener('click', () => switchTab('works'));
    tabEvents.addEventListener('click', () => switchTab('events'));
    tabNews.addEventListener('click', () => switchTab('news'));

    document.querySelectorAll('.tag-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const tag = btn.dataset.tag;
        if (selectedTags.includes(tag)) {
          selectedTags = selectedTags.filter(t => t !== tag);
          btn.classList.remove('bg-emerald-600', 'text-white', 'border-emerald-600');
          btn.classList.add('bg-white', 'text-slate-800');
        } else {
          selectedTags.push(tag);
          btn.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600');
          btn.classList.remove('bg-white', 'text-slate-800');
        }
        updateMarkdownPreview();
      });
    });

    async function compressImage(file, maxDimension = 1600, quality = 0.82) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const img = new Image();
          img.onload = () => {
            let width = img.width;
            let height = img.height;
            if (width > height) {
              if (width > maxDimension) {
                height = Math.round((height * maxDimension) / width);
                width = maxDimension;
              }
            } else {
              if (height > maxDimension) {
                width = Math.round((width * maxDimension) / height);
                height = maxDimension;
              }
            }

            const canvas = document.createElement('canvas');
            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, width, height);

            canvas.toBlob(
              (blob) => {
                if (blob) {
                  resolve(blob);
                } else {
                  reject(new Error('Canvas WebP conversion failed'));
                }
              },
              'image/webp',
              quality
            );
          };
          img.onerror = reject;
          img.src = e.target.result;
        };
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    }

    function formatBytes(bytes, decimals = 1) {
      if (bytes === 0) return '0 B';
      const k = 1024;
      const dm = decimals < 0 ? 0 : decimals;
      const sizes = ['B', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
    }

    const photoInput = document.getElementById('photo-input');
    const photoRepeaterList = document.getElementById('photo-repeater-list');
    const processingIndicator = document.getElementById('processing-indicator');
    const processingText = document.getElementById('processing-text');
    const photoCountBadge = document.getElementById('photo-count-badge');
    const compressionSummary = document.getElementById('compression-summary');
    const compressionStats = document.getElementById('compression-stats');

    photoInput.addEventListener('change', async (e) => {
      const files = Array.from(e.target.files);
      if (!files.length) return;

      processingIndicator.classList.remove('hidden');

      for (let i = 0; i < files.length; i++) {
        const file = files[i];
        processingText.textContent = `写真 (${i + 1}/${files.length}) をWebPへ軽量化中...`;
        try {
          const webpBlob = await compressImage(file);
          const previewUrl = URL.createObjectURL(webpBlob);
          const isFirstImage = uploadedImages.length === 0;

          uploadedImages.push({
            id: 'img_' + Date.now() + '_' + Math.random().toString(36).substring(2, 7),
            file: file,
            originalSize: file.size,
            webpBlob: webpBlob,
            webpSize: webpBlob.size,
            caption: '',
            isThumbnail: isFirstImage,
            previewUrl: previewUrl
          });
        } catch (err) {
          console.error('画像変換エラー:', err);
        }
      }

      processingIndicator.classList.add('hidden');
      photoInput.value = '';
      renderPhotoList();
      updateMarkdownPreview();
    });
    function renderPhotoList() {
      photoRepeaterList.innerHTML = '';
      photoCountBadge.textContent = `${uploadedImages.length} 枚選択中`;

      if (uploadedImages.length === 0) {
        compressionSummary.classList.add('hidden');
        return;
      }

      let totalOriginal = 0;
      let totalWebp = 0;

      uploadedImages.forEach((item, index) => {
        totalOriginal += item.originalSize;
        totalWebp += item.webpSize;
        const reduction = Math.round((1 - item.webpSize / item.originalSize) * 100);

        const card = document.createElement('div');
        card.className = `p-3.5 rounded-xl border transition-all ${
          item.isThumbnail ? 'border-emerald-500 bg-emerald-50/30 ring-1 ring-emerald-500' : 'border-slate-200 bg-white'
        }`;

        card.innerHTML = `
          <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center">
            <div class="relative w-24 h-24 sm:w-20 sm:h-20 rounded-lg overflow-hidden bg-slate-100 flex-shrink-0 border border-slate-200">
              <img src="${item.previewUrl}" alt="preview" class="w-full h-full object-cover" />
              ${item.isThumbnail ? '<span class="absolute bottom-0 inset-x-0 bg-emerald-600 text-white text-[9px] font-bold text-center py-0.5">メイン写真</span>' : ''}
            </div>

            <div class="flex-1 w-full space-y-2">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-bold text-slate-700">#${index + 1}</span>
                  <span class="text-[11px] text-slate-500">
                    元: ${formatBytes(item.originalSize)} ➔ <strong class="text-emerald-700">${formatBytes(item.webpSize)}</strong> (${reduction}%減)
                  </span>
                </div>
                <div class="flex items-center gap-1">
                  <button type="button" class="btn-move-up p-1 text-slate-400 hover:text-slate-700 disabled:opacity-30 cursor-pointer" ${index === 0 ? 'disabled' : ''} title="上へ">▲</button>
                  <button type="button" class="btn-move-down p-1 text-slate-400 hover:text-slate-700 disabled:opacity-30 cursor-pointer" ${index === uploadedImages.length - 1 ? 'disabled' : ''} title="下へ">▼</button>
                  <button type="button" class="btn-delete p-1 text-rose-400 hover:text-rose-600 ml-1 cursor-pointer" title="削除">✕</button>
                </div>
              </div>

              <input
                type="text"
                value="${item.caption}"
                placeholder="場所・キャプション（例: 中庭を望む開放的なリビング）"
                class="photo-caption w-full px-3 py-1.5 rounded border border-slate-200 text-xs focus:ring-1 focus:ring-emerald-500"
              />

              <label class="inline-flex items-center gap-1.5 cursor-pointer text-xs text-slate-600">
                <input type="radio" name="thumbnail-select" class="thumbnail-radio text-emerald-600 focus:ring-emerald-500" ${item.isThumbnail ? 'checked' : ''} />
                <span>この写真を一覧のサムネイル（メイン写真）にする</span>
              </label>
            </div>
          </div>
        `;

        card.querySelector('.photo-caption').addEventListener('input', (e) => {
          item.caption = e.target.value;
          updateMarkdownPreview();
        });

        card.querySelector('.thumbnail-radio').addEventListener('change', () => {
          uploadedImages.forEach(img => img.isThumbnail = false);
          item.isThumbnail = true;
          renderPhotoList();
          updateMarkdownPreview();
        });

        card.querySelector('.btn-delete').addEventListener('click', () => {
          URL.revokeObjectURL(item.previewUrl);
          uploadedImages.splice(index, 1);
          if (item.isThumbnail && uploadedImages.length > 0) {
            uploadedImages[0].isThumbnail = true;
          }
          renderPhotoList();
          updateMarkdownPreview();
        });

        const btnUp = card.querySelector('.btn-move-up');
        if (btnUp) {
          btnUp.addEventListener('click', () => {
            if (index > 0) {
              const temp = uploadedImages[index];
              uploadedImages[index] = uploadedImages[index - 1];
              uploadedImages[index - 1] = temp;
              renderPhotoList();
              updateMarkdownPreview();
            }
          });
        }

        const btnDown = card.querySelector('.btn-move-down');
        if (btnDown) {
          btnDown.addEventListener('click', () => {
            if (index < uploadedImages.length - 1) {
              const temp = uploadedImages[index];
              uploadedImages[index] = uploadedImages[index + 1];
              uploadedImages[index + 1] = temp;
              renderPhotoList();
              updateMarkdownPreview();
            }
          });
        }

        photoRepeaterList.appendChild(card);
      });

      const totalReduction = Math.round((1 - totalWebp / totalOriginal) * 100);
      compressionSummary.classList.remove('hidden');
      compressionStats.textContent = `合計 ${formatBytes(totalOriginal)} ➔ ${formatBytes(totalWebp)} (${totalReduction}% 軽量化)`;
    }
    function generateMarkdownData() {
      const today = new Date().toISOString().split('T')[0];
      let slug = '';
      let filename = '';
      let mdContent = '';

      if (currentTab === 'works') {
        const title = document.getElementById('work-title').value.trim() || '無題の施工事例';
        const category = document.getElementById('work-category').value;
        const city = document.getElementById('work-city').value.trim();
        const floorSpace = document.getElementById('work-floorspace').value.trim();
        const family = document.getElementById('work-family').value.trim();
        const structure = document.getElementById('work-structure').value.trim();
        const body = document.getElementById('work-body').value.trim();

        slug = 'works-' + today + '-' + Math.random().toString(36).substring(2, 6);
        filename = `${slug}.md`;

        let thumbnailPath = '';
        let galleryPaths = [];

        uploadedImages.forEach((img, idx) => {
          const imgName = img.isThumbnail ? 'thumbnail.webp' : `gallery-${idx + 1}.webp`;
          const relativePath = `./images/${imgName}`;
          if (img.isThumbnail && !thumbnailPath) {
            thumbnailPath = relativePath;
          } else {
            galleryPaths.push(relativePath);
          }
        });

        if (!thumbnailPath && galleryPaths.length > 0) {
          thumbnailPath = galleryPaths[0];
        }

        mdContent = `---
title: "${title.replace(/"/g, '\\"')}"
pubDate: ${today}
category: "${category}"
${thumbnailPath ? `thumbnail: "${thumbnailPath}"` : ''}
${city ? `city: "${city}"` : ''}
${structure ? `structure: "${structure}"` : ''}
${family ? `family: "${family}"` : ''}
${floorSpace ? `floorSpace: "${floorSpace}"` : ''}
tags: [${selectedTags.map(t => `"${t}"`).join(', ')}]
featured: false
---

${body}

${uploadedImages.map((img, idx) => {
  const cap = img.caption ? `\n*${img.caption}*` : '';
  const imgName = img.isThumbnail ? 'thumbnail.webp' : `gallery-${idx + 1}.webp`;
  return `![${img.caption || title}](./images/${imgName})${cap}`;
}).join('\n\n')}
`;
      } else if (currentTab === 'events') {
        const title = document.getElementById('event-title').value.trim() || '無題の見学会イベント';
        const eventDate = document.getElementById('event-date').value.trim();
        const location = document.getElementById('event-location').value.trim();
        const reservation = document.getElementById('event-reservation').checked;
        const body = document.getElementById('event-body').value.trim();

        slug = 'event-' + today + '-' + Math.random().toString(36).substring(2, 6);
        filename = `${slug}.md`;
        const thumbnailPath = uploadedImages.length > 0 ? './images/thumbnail.webp' : '';

        mdContent = `---
title: "${title.replace(/"/g, '\\"')}"
pubDate: ${today}
status: "開催前"
${thumbnailPath ? `thumbnail: "${thumbnailPath}"` : ''}
${eventDate ? `eventDate: "${eventDate}"` : ''}
${location ? `location: "${location}"` : ''}
reservationRequired: ${reservation}
---

${body}
`;
      } else if (currentTab === 'news') {
        const title = document.getElementById('news-title').value.trim() || '無題のお知らせ';
        const body = document.getElementById('news-body').value.trim();

        slug = 'news-' + today + '-' + Math.random().toString(36).substring(2, 6);
        filename = `${slug}.md`;

        mdContent = `---
title: "${title.replace(/"/g, '\\"')}"
pubDate: ${today}
category: "お知らせ"
---

${body}
`;
      }

      return { slug, filename, mdContent };
    }
    function updateMarkdownPreview() {
      const { filename, mdContent } = generateMarkdownData();
      document.getElementById('preview-filename').textContent = `content/${currentTab}/${filename}`;
      document.getElementById('markdown-preview').textContent = mdContent;
    }

    document.getElementById('entry-form').addEventListener('input', updateMarkdownPreview);

    const btnTogglePreview = document.getElementById('btn-toggle-preview');
    const previewContainer = document.getElementById('preview-container');

    btnTogglePreview.addEventListener('click', () => {
      const isHidden = previewContainer.classList.contains('hidden');
      if (isHidden) {
        previewContainer.classList.remove('hidden');
      } else {
        previewContainer.classList.add('hidden');
      }
    });

    document.getElementById('btn-copy-markdown').addEventListener('click', () => {
      const { mdContent } = generateMarkdownData();
      navigator.clipboard.writeText(mdContent).then(() => {
        alert('Markdownをクリップボードにコピーしました！');
      });
    });

    document.getElementById('btn-download-zip').addEventListener('click', async () => {
      const btn = document.getElementById('btn-download-zip');
      const originalText = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = `<span>⏳ ZIPパッケージ作成中...</span>`;

      try {
        const { slug, filename, mdContent } = generateMarkdownData();
        const zip = new JSZip();

        const folder = zip.folder(slug);
        folder.file(filename, mdContent);

        if (uploadedImages.length > 0) {
          const imgFolder = folder.folder('images');
          uploadedImages.forEach((img, idx) => {
            const imgName = img.isThumbnail ? 'thumbnail.webp' : `gallery-${idx + 1}.webp`;
            imgFolder.file(imgName, img.webpBlob);
          });
        }

        const content = await zip.generateAsync({ type: 'blob' });
        const downloadUrl = URL.createObjectURL(content);
        const a = document.createElement('a');
        a.href = downloadUrl;
        a.download = `${slug}.zip`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(downloadUrl);

        alert(`更新パッケージ (${slug}.zip) のダウンロードが完了しました！\nメールやLINEで担当ディレクターへ送付してください。`);
      } catch (err) {
        console.error('ZIP作成エラー:', err);
        alert('ZIPパッケージの作成に失敗しました: ' + err.message);
      } finally {
        btn.disabled = false;
        btn.innerHTML = originalText;
      }
    });

    updateMarkdownPreview();
  </script>
</body>
</html>
