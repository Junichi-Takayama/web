---
---
<header data-site-header class="bg-stone-50/90 backdrop-blur-md border-b border-stone-200 sticky top-0 z-50 transition-all duration-300">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- ロゴ枠 -->
    <a href="/" class="flex flex-col group">
      <span class="font-en-serif text-xl tracking-widest font-semibold text-stone-900 group-hover:text-stone-600 transition">ArCraft</span>
      <span class="text-xs tracking-widest text-stone-500 uppercase font-sans">Next-Gen Web Engine</span>
    </a>

    <!-- デスクトップナビゲーション -->
    <nav class="hidden md:flex items-center gap-7 text-xs tracking-wider uppercase font-medium text-stone-700">
      <a href="/" class="hover:text-stone-950 transition duration-200">Home</a>
      <a href="/service/" class="hover:text-stone-950 transition duration-200">Service</a>
      <a href="/company/" class="hover:text-stone-950 transition duration-200">About</a>
      <a href="/works/" class="hover:text-stone-950 transition duration-200">Works</a>
      <a href="/news/" class="hover:text-stone-950 transition duration-200">News</a>
      <a href="/animations/" class="text-stone-500 hover:text-stone-950 transition duration-200 flex items-center gap-1 font-mono">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        Motion
      </a>
      <a href="/styleguide/" class="text-stone-600 hover:text-stone-950 transition duration-200 font-mono text-xs">
        StyleGuide
      </a>
      <a href="/components/" class="text-amber-800 hover:text-amber-950 transition duration-200 font-mono text-xs font-semibold flex items-center gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span>
        Catalog (25)
      </a>
      <a href="/contact/" class="px-5 py-2.5 bg-stone-900 hover:bg-stone-800 text-stone-100 font-medium transition duration-200 text-xs tracking-widest shadow-sm hover:shadow">
        無料診断・相談
      </a>
    </nav>

    <!-- モバイルハンバーガーボタン -->
    <button 
      type="button"
      data-mobile-menu-btn 
      class="md:hidden p-2 text-stone-800 focus:outline-none focus:ring-2 focus:ring-stone-400 rounded-sm" 
      aria-label="メニューを開く"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path class="transition-all duration-300" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- モバイルメニュー（ドロワーアニメーション） -->
  <div 
    id="mobile-menu" 
    data-mobile-menu 
    class="hidden md:hidden bg-stone-50 border-b border-stone-200 px-4 sm:px-6 py-6 transition-all duration-300 opacity-0 -translate-y-4"
  >
    <nav class="flex flex-col gap-4 text-xs uppercase tracking-wider font-medium text-stone-800">
      <a href="/" class="py-2 border-b border-stone-200 hover:text-stone-500">Home / トップ</a>
      <a href="/service/" class="py-2 border-b border-stone-200 hover:text-stone-500">Service / サービス・料金</a>
      <a href="/company/" class="py-2 border-b border-stone-200 hover:text-stone-500">About / ArCraftの想い</a>
      <a href="/works/" class="py-2 border-b border-stone-200 hover:text-stone-500">Works / 制作実績・事例</a>
      <a href="/news/" class="py-2 border-b border-stone-200 hover:text-stone-500">News / お知らせ</a>
      <a href="/animations/" class="py-2 border-b border-stone-200 text-stone-900 font-bold flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        Motion / アニメーション見本
      </a>
      <a href="/styleguide/" class="py-2 border-b border-stone-200 text-stone-700 flex items-center gap-1.5">
        StyleGuide / スタイルガイド
      </a>
      <a href="/components/" class="py-2 border-b border-stone-200 text-amber-800 font-bold flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-amber-600"></span>
        Catalog / 汎用25種コンポーネント
      </a>
      <a href="/contact/" class="mt-2 text-center py-3 bg-stone-900 text-white font-medium text-xs tracking-widest">
        無料診断・お問い合わせ
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector('[data-mobile-menu-btn]');
  const menu = document.querySelector('[data-mobile-menu]');
  let isOpen = false;

  if (btn && menu) {
    btn.addEventListener('click', () => {
      isOpen = !isOpen;
      btn.setAttribute('aria-expanded', String(isOpen));
      btn.setAttribute('aria-label', isOpen ? 'メニューを閉じる' : 'メニューを開く');

      if (isOpen) {
        menu.classList.remove('hidden');
        requestAnimationFrame(() => {
          menu.classList.remove('opacity-0', '-translate-y-4');
          menu.classList.add('opacity-100', 'translate-y-0');
        });
      } else {
        menu.classList.remove('opacity-100', 'translate-y-0');
        menu.classList.add('opacity-0', '-translate-y-4');
        setTimeout(() => {
          if (!isOpen) {
            menu.classList.add('hidden');
          }
        }, 300);
      }
    });
  }
</script>




