<footer class="bg-stone-900 text-stone-300 pt-20 pb-12 border-t border-stone-800">
  <div class="max-w-7xl mx-auto px-4 md:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12 mb-16">
    <!-- 左側: 社名・住所・SNS -->
    <div class="lg:col-span-5 space-y-6">
      <div>
        <span class="font-en-serif text-2xl tracking-[0.25em] font-semibold text-white block mb-1">ARCH CRAFT</span>
        <span class="text-[10px] tracking-[0.3em] text-stone-400 uppercase font-sans">Architects & Studio Inc.</span>
      </div>
      <div class="text-xs leading-relaxed text-stone-400 space-y-1">
        <p class="font-medium text-stone-200 text-sm">ARCH CRAFT STUDIO 株式会社</p>
        <p>一級建築士事務所 東京都知事登録 第00000号</p>
        <p>〒107-0062 東京都港区南青山5-10-2 STUDIO AOYAMA 3F</p>
      </div>
      <!-- SNSアイコン -->
      <div class="flex items-center gap-3 pt-2 text-xs">
        <a href="#" class="w-9 h-9 rounded-full border border-stone-700 text-stone-300 flex items-center justify-center hover:bg-stone-800 hover:text-white transition" aria-label="Instagram">
          <span class="font-bold">IG</span>
        </a>
        <a href="#" class="w-9 h-9 rounded-full border border-stone-700 text-stone-300 flex items-center justify-center hover:bg-stone-800 hover:text-white transition" aria-label="Pinterest">
          <span class="font-bold">PT</span>
        </a>
        <a href="#" class="w-9 h-9 rounded-full border border-stone-700 text-stone-300 flex items-center justify-center hover:bg-stone-800 hover:text-white transition" aria-label="X / Twitter">
          <span class="font-bold">X</span>
        </a>
      </div>
    </div>

    <!-- 中央: フッターリンク 2列 -->
    <div class="lg:col-span-3 grid grid-cols-2 gap-6 text-xs leading-loose text-stone-400">
      <div class="space-y-2">
        <p class="text-stone-200 font-semibold mb-2">Navigation</p>
        <p><a href="/" class="hover:text-white transition">トップページ</a></p>
        <p><a href="/service/" class="hover:text-white transition">事業内容・設計</a></p>
        <p><a href="/works/" class="hover:text-white transition">施工・設計事例</a></p>
        <p><a href="/company/" class="hover:text-white transition">会社概要・思想</a></p>
      </div>
      <div class="space-y-2">
        <p class="text-stone-200 font-semibold mb-2">Information</p>
        <p><a href="/news/" class="hover:text-white transition">お知らせ・見学会</a></p>
        <p><a href="/blog/" class="hover:text-white transition">建築日誌・Journal</a></p>
        <p><a href="/contact/" class="hover:text-white transition">ご相談・お見積り</a></p>
        <p><a href="/privacy/" class="hover:text-white transition">プライバシーポリシー</a></p>
        <p><a href="/styleguide/" class="text-amber-400 hover:text-amber-300 transition">スタイルガイド</a></p>
      </div>
    </div>

    <!-- 右側: お問い合わせボックス -->
    <div class="lg:col-span-4 space-y-4">
      <div class="bg-stone-800/80 p-6 rounded border border-stone-700">
        <p class="text-[10px] tracking-widest text-stone-400 uppercase mb-1">Consultation / Contact</p>
        <p class="text-sm font-semibold text-white mb-2">家づくり・リノベーションのご相談</p>
        <p class="text-xs text-stone-400 leading-relaxed mb-4">
          土地探しから新築設計、リノベーションまで、まずはお気軽にご相談ください。
        </p>
        <a href="/contact/" class="block text-center py-3 px-4 bg-stone-100 hover:bg-white text-stone-900 font-bold text-xs tracking-wider transition shadow-sm">
          無料相談を予約する
        </a>
      </div>
      <div class="text-right text-xs text-stone-400">
        <p>Tel. 03-6400-0000 <span class="text-[10px] text-stone-500">（水曜定休 10:00〜18:00）</span></p>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 md:px-8 pt-8 border-t border-stone-800 flex flex-col md:flex-row justify-between items-center text-xs text-stone-500 gap-4">
    <p>&copy; 2026 ARCH CRAFT STUDIO Inc. All Rights Reserved.</p>
    <div class="flex gap-6 text-[11px]">
      <a href="/privacy/" class="hover:text-stone-300 transition">プライバシーポリシー</a>
      <a href="/company/" class="hover:text-stone-300 transition">特定商取引法に基づく表記</a>
    </div>
  </div>
</footer>



