---
export interface FeatureItem {
  icon?: string;
  tag: string;
  title: string;
  description: string;
}

export interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  features?: FeatureItem[];
  columns?: 3 | 4;
}

const {
  eyebrow = "Core Strengths",
  title = "選ばれる3つの技術革新と特徴",
  description = "ただ新しいだけでなく、中小企業の現場で本当に使い続けられる実用性と強固な基盤を提供します。",
  columns = 3,
  features = [
    {
      icon: "⚡",
      tag: "SPEED",
      title: "0秒台の超高速表示",
      description: "最新の静的生成エンジンAstroとグローバルCDNにより、重いデータベース通信を排除し即座に表示されます。"
    },
    {
      icon: "🔒",
      tag: "SECURITY",
      title: "生涯メンテナンスフリー",
      description: "WordPressのように更新で崩れる心配やプラグイン脆弱性のリスクがなく、一度作れば修理費ゼロで稼働します。"
    },
    {
      icon: "📱",
      tag: "USABILITY",
      title: "スマホから直感更新",
      description: "複雑な管理画面を覚える必要はありません。SNSのようにスマホから写真とテキストを入力するだけで反映されます。"
    }
  ]
} = Astro.props;
---

<section class="py-20 md:py-28 px-6 bg-white">
  <div class="max-w-6xl mx-auto space-y-12">
    <!-- ヘッダー -->
    <div class="text-center max-w-2xl mx-auto space-y-3">
      <span class="font-mono text-xs text-stone-400 tracking-widest uppercase block">{eyebrow}</span>
      <h2 class="font-serif-title text-2xl md:text-3xl font-medium text-stone-900 tracking-wide">{title}</h2>
      <p class="text-xs text-stone-600 font-light leading-relaxed">{description}</p>
    </div>

    <!-- グリッド -->
    <div class={`grid grid-cols-1 md:grid-cols-${columns} gap-8`}>
      {features.map((f) => (
        <div class="group p-8 border border-stone-200 rounded-sm bg-stone-50/50 hover:bg-white hover:border-stone-400 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 space-y-4 cursor-default">
          <div class="flex items-center justify-between">
            <span class="text-2xl inline-block transform group-hover:scale-115 transition-transform duration-300">{f.icon}</span>
            <span class="font-mono text-[10px] text-stone-400 uppercase tracking-widest group-hover:text-stone-900 transition-colors">{f.tag}</span>
          </div>
          <h3 class="font-serif-title text-lg font-bold text-stone-900 leading-snug group-hover:text-stone-700 transition-colors">
            {f.title}
          </h3>
          <p class="text-xs text-stone-600 font-light leading-relaxed">
            {f.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
