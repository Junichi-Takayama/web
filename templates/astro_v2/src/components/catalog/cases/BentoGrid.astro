---
export interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
}

const {
  eyebrow = "Modern Showcase",
  title = "ArCraftの統合テクノロジー・エコシステム",
  subtitle = "単一の技術ではなく、業界標準の最新ツールを精緻に組み合わせたWeb制作基盤。"
} = Astro.props;
---

<section class="py-20 md:py-28 px-6 bg-white">
  <div class="max-w-6xl mx-auto space-y-12">
    <div class="text-center max-w-2xl mx-auto space-y-3">
      <span class="font-mono text-xs text-stone-400 tracking-widest uppercase block">{eyebrow}</span>
      <h2 class="font-serif-title text-2xl md:text-3xl font-medium text-stone-900 tracking-wide">{title}</h2>
      <p class="text-xs text-stone-600 font-light leading-relaxed">{subtitle}</p>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- 大カード 1 (2カラム幅) -->
      <div class="group md:col-span-2 bg-stone-900 text-white p-8 rounded-sm shadow-sm hover:shadow-2xl hover:border-stone-700 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between space-y-6 cursor-default">
        <div class="space-y-3">
          <span class="font-mono text-xs text-stone-400 uppercase tracking-widest group-hover:text-stone-300 transition-colors">CORE ENGINE</span>
          <h3 class="font-serif-title text-2xl font-bold text-white group-hover:text-stone-100 transition-colors">Astro Islands アーキテクチャ</h3>
          <p class="text-xs text-stone-300 font-light leading-relaxed max-w-xl group-hover:text-stone-200 transition-colors">
            不要なJavaScriptをブラウザに送信せず、必要な部分だけをインタラクティブ化。ページ全体の読み込み速度が従来のWordPressと比較して最大5倍に向上します。
          </p>
        </div>
        <div class="flex items-center gap-4 text-xs font-mono text-stone-400 pt-4 border-t border-stone-800">
          <span>0 JavaScript By Default</span>
          <span>•</span>
          <span>Lighthouse 95+</span>
        </div>
      </div>

      <!-- 小カード 1 -->
      <div class="group bg-stone-50 border border-stone-200 p-8 rounded-sm shadow-xs hover:border-stone-400 hover:bg-white hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between space-y-4 cursor-default">
        <div class="space-y-2">
          <span class="font-mono text-xs text-stone-400 uppercase tracking-widest group-hover:text-stone-600 transition-colors">HOSTING</span>
          <h3 class="font-serif-title text-lg font-bold text-stone-900 group-hover:text-stone-700 transition-colors">Cloudflare Pages</h3>
          <p class="text-xs text-stone-600 font-light leading-relaxed">
            世界300都市以上のエッジサーバーから瞬時に配信。DDoS攻撃やアクセス集中にも強固。
          </p>
        </div>
        <span class="font-mono text-xs text-stone-900 font-bold">稼働率 99.99%</span>
      </div>

      <!-- 小カード 2 -->
      <div class="group bg-stone-50 border border-stone-200 p-8 rounded-sm shadow-xs hover:border-stone-400 hover:bg-white hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between space-y-4 cursor-default">
        <div class="space-y-2">
          <span class="font-mono text-xs text-stone-400 uppercase tracking-widest group-hover:text-stone-600 transition-colors">CMS</span>
          <h3 class="font-serif-title text-lg font-bold text-stone-900 group-hover:text-stone-700 transition-colors">microCMS 連携</h3>
          <p class="text-xs text-stone-600 font-light leading-relaxed">
            日本国産の直感的ヘッドレスCMS。現場の担当者がマニュアル不要で更新可能。
          </p>
        </div>
        <span class="font-mono text-xs text-stone-900 font-bold">API応答 100ms以内</span>
      </div>

      <!-- 大カード 2 (2カラム幅) -->
      <div class="group md:col-span-2 bg-stone-100 border border-stone-200 p-8 rounded-sm shadow-xs hover:border-stone-400 hover:bg-stone-50 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between space-y-6 cursor-default">
        <div class="space-y-3">
          <span class="font-mono text-xs text-stone-400 uppercase tracking-widest group-hover:text-stone-600 transition-colors">PARTNERSHIP</span>
          <h3 class="font-serif-title text-xl font-bold text-stone-900 group-hover:text-stone-700 transition-colors">作って終わらせない月次伴走サポート</h3>
          <p class="text-xs text-stone-600 font-light leading-relaxed max-w-xl">
            GA4アクセス解析レポートの提出、ドメイン・DNS安全監視、日常的なコンテンツ更新代行まで、専任ディレクターが貴社と横に並んで歩みます。
          </p>
        </div>
        <div class="flex items-center gap-4 text-xs font-mono text-stone-600 pt-4 border-t border-stone-200">
          <span>毎月レポート提出</span>
          <span>•</span>
          <span>更新代行対応</span>
        </div>
      </div>
    </div>
  </div>
</section>
