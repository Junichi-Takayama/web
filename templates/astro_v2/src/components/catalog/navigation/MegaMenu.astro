---
export interface MegaSubItem {
  title: string;
  description: string;
  href: string;
}

export interface MegaCategory {
  category: string;
  items: MegaSubItem[];
}

export interface Props {
  triggerLabel?: string;
  categories?: MegaCategory[];
  featuredTitle?: string;
  featuredDesc?: string;
  featuredHref?: string;
}

const {
  triggerLabel = "ソリューション一覧",
  categories = [
    {
      category: "Web制作・開発",
      items: [
        { title: "コーポレートサイト制作", description: "超高速表示と信頼感を両立する標準仕様", href: "#" },
        { title: "WordPress移行・リプレイス", description: "既存資産を壊さず安全に新基盤へ移設", href: "#" }
      ]
    },
    {
      category: "保守・伴走運用",
      items: [
        { title: "GA4アクセス解析レポート", description: "月次の数値可視化と改善提案", href: "#" },
        { title: "更新代行・インフラ監視", description: "日常的な変更や障害対応をワンストップ化", href: "#" }
      ]
    }
  ],
  featuredTitle = "【無料】Webサイト健康診断",
  featuredDesc = "貴社サイトの表示速度・保守リスク・SEO課題を客観的にレポートします。",
  featuredHref = "#contact"
} = Astro.props;
---

<div class="w-full bg-white border border-stone-200 rounded-sm shadow-lg p-6 md:p-8 max-w-4xl mx-auto">
  <!-- メガメニュー ヘッダー見出し (h3) -->
  <div class="flex items-center gap-2 mb-6 pb-3 border-b border-stone-200">
    <span class="w-2.5 h-2.5 rounded-full bg-stone-900"></span>
    <h3 class="font-mono text-base sm:text-lg font-bold text-stone-900 tracking-wide">{triggerLabel}</h3>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    <!-- カテゴリ別カラム -->
    {categories.map((cat) => (
      <div class="space-y-4">
        <h4 class="text-sm sm:text-base font-bold text-stone-900 tracking-wide pb-2 border-b border-stone-200">
          {cat.category}
        </h4>
        <div class="space-y-2">
          {cat.items.map((item) => (
            <a href={item.href} class="block group p-3 -mx-3 rounded-sm hover:bg-stone-50 transition-colors">
              <span class="text-base font-semibold text-stone-900 group-hover:text-stone-950 flex items-center justify-between">
                <span>{item.title}</span>
                <span class="text-stone-400 group-hover:text-stone-900 group-hover:translate-x-1 transition-all text-sm">&rarr;</span>
              </span>
              <p class="text-sm text-stone-600 font-normal mt-1 leading-relaxed group-hover:text-stone-700">
                {item.description}
              </p>
            </a>
          ))}
        </div>
      </div>
    ))}

    <!-- 特集・バナー枠 -->
    <div class="bg-stone-50 border border-stone-200 p-6 rounded-sm flex flex-col justify-between hover:border-stone-400 hover:shadow-xs transition-all">
      <div class="space-y-3">
        <span class="inline-block px-2.5 py-1 bg-stone-900 text-white text-xs font-mono tracking-widest uppercase rounded-xs">Recommend</span>
        <h4 class="text-base font-bold text-stone-900 leading-snug">{featuredTitle}</h4>
        <p class="text-sm text-stone-600 leading-relaxed font-light">{featuredDesc}</p>
      </div>
      <a href={featuredHref} class="group mt-6 flex items-center justify-center gap-2 py-3 px-4 bg-stone-900 text-white text-sm font-medium hover:bg-stone-800 hover:shadow-sm active:scale-[0.98] transition-all rounded-xs">
        <span>詳しく見る</span>
        <span class="inline-block transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
      </a>
    </div>
  </div>
</div>
