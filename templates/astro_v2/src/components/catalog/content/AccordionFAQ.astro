---
export interface FAQItem {
  question: string;
  answer: string;
}

export interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  faqs?: FAQItem[];
}

const {
  eyebrow = "Frequently Asked Questions",
  title = "よくあるご質問",
  subtitle = "導入や既存サイトからの乗り換えについて、よくいただくご質問にお答えします。",
  faqs = [
    {
      question: "現在WordPressを使っていますが、記事や画像は引き継げますか？",
      answer: "はい、可能です。これまでに投稿されたお知らせ、施工事例、ブログ記事、および画像データを安全にエクスポートし、新しいmicroCMS環境へ移行いたします。URL構造も極力維持し、SEO評価を損なわないよう移設します。"
    },
    {
      question: "パソコン操作が苦手ですが、自分でお知らせや施工事例を更新できますか？",
      answer: "ご安心ください。WordPressのように複雑な管理画面ではなく、スマートフォンからSNS感覚で写真とテキストを入力するだけの専用画面をご用意します。また、月次伴走プランでは代理投稿も承っております。"
    },
    {
      question: "月次伴走プランは必ず加入しなければなりませんか？",
      answer: "必須ではございません。基本換装プランのみ（買い切り）での納品も可能です。ただし、地方中小企業様の実情として『社内にWeb担当者がおらず更新が滞る』ケースが多いため、月次レポートと更新代行がセットになった伴走プランを強く推奨しております。"
    },
    {
      question: "他社で作成したサイトのサーバー放置やトラブルも相談できますか？",
      answer: "はい、多くのご相談をいただいております。『制作会社が廃業した』『担当者と連絡がつかなくなった』といった状態でも、まず無料診断にて現状のドメインやサーバー状況を客観的に調査・レポートいたします。"
    }
  ]
} = Astro.props;
---

<section class="py-20 md:py-28 px-6 bg-white">
  <div class="max-w-3xl mx-auto space-y-12">
    <div class="text-left md:text-center space-y-3">
      <span class="font-mono text-xs text-stone-400 tracking-widest uppercase block">{eyebrow}</span>
      <h2 class="font-serif-title text-xl sm:text-2xl md:text-3xl font-medium text-stone-900 tracking-wide">{title}</h2>
      <p class="text-sm sm:text-base text-stone-600 font-light leading-relaxed">{subtitle}</p>
    </div>

    <!-- ネイティブdetailsを使用したアコーディオン（スムーズアニメーション付き） -->
    <div class="faq-container divide-y divide-stone-200 border-t border-b border-stone-200">
      {faqs.map((faq) => (
        <details class="faq-item group py-3">
          <summary class="flex items-center justify-between cursor-pointer list-none text-base sm:text-lg font-medium text-stone-900 select-none p-4 -mx-3 rounded-sm hover:bg-stone-50/80 transition-colors">
            <span class="flex items-start gap-3">
              <span class="font-serif-title text-base font-medium text-stone-400 group-hover:text-stone-900 transition-colors">Q.</span>
              <span class="pt-0.5 group-hover:text-stone-700 transition-colors">{faq.question}</span>
            </span>
            <span class="faq-icon ml-4 w-6 h-6 rounded-full flex items-center justify-center bg-stone-100 group-hover:bg-stone-900 group-hover:text-white text-stone-500 text-xs transition-all duration-300 group-open:rotate-180 flex-shrink-0">
              ▼
            </span>
          </summary>
          <div class="faq-content overflow-hidden">
            <div class="pt-3 pb-3 pl-8 pr-4 text-sm sm:text-base text-stone-700 font-light leading-relaxed">
              <p>{faq.answer}</p>
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  // detailsタグの開閉をスムーズに行うWeb Animations APIスクリプト
  function initFaqAccordion() {
    const faqItems = document.querySelectorAll<HTMLDetailsElement>('details.faq-item');

    faqItems.forEach((detail) => {
      const summary = detail.querySelector('summary');
      const content = detail.querySelector<HTMLElement>('.faq-content');
      if (!summary || !content) return;

      // 既にリスナーが登録されていないか確認
      if (detail.dataset.animated === 'true') return;
      detail.dataset.animated = 'true';

      let isAnimating = false;

      summary.addEventListener('click', (e) => {
        e.preventDefault();
        if (isAnimating) return;

        if (detail.open) {
          // 閉じるアニメーション
          isAnimating = true;
          const startHeight = content.offsetHeight;
          
          const closing = content.animate(
            [
              { height: `${startHeight}px`, opacity: 1 },
              { height: '0px', opacity: 0 }
            ],
            { duration: 250, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' }
          );

          closing.onfinish = () => {
            detail.removeAttribute('open');
            isAnimating = false;
          };
        } else {
          // 開くアニメーション
          detail.setAttribute('open', '');
          isAnimating = true;
          const endHeight = content.offsetHeight;

          const opening = content.animate(
            [
              { height: '0px', opacity: 0 },
              { height: `${endHeight}px`, opacity: 1 }
            ],
            { duration: 250, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' }
          );

          opening.onfinish = () => {
            isAnimating = false;
          };
        }
      });
    });
  }

  // 初回実行およびAstroのページ遷移時実行
  initFaqAccordion();
  document.addEventListener('astro:page-load', initFaqAccordion);
</script>
