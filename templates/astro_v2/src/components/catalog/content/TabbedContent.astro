---
export interface TabItem {
  id: string;
  label: string;
  title: string;
  description: string;
  points: string[];
}

export interface Props {
  eyebrow?: string;
  title?: string;
  tabs?: TabItem[];
}

const {
  eyebrow = "Selectable Solutions",
  title = "業種別・課題別の導入アプローチ",
  tabs = [
    {
      id: "builders",
      label: "工務店・建築業",
      title: "作品の美しさを損なわない0秒表示と施工事例の即時投稿",
      description: "重い高画質写真を自動的にWebP圧縮し、スマホでも瞬時に高解像度ギャラリーを表示。現場監督や営業が現場から施工写真を即時投稿できます。",
      points: ["スマホから外出先で写真アップロード", "HEAT20や耐震等級等の性能スペック表テンプレート", "見学会・イベント予約フォーム完備"]
    },
    {
      id: "manufacturing",
      label: "製造業・BtoB",
      title: "技術力と製品スペックを正確に伝える堅牢なコーポレート基盤",
      description: "設備の仕様や技術情報を整理し、BtoBの取引先や採用応募者に信頼感を与えるWebサイトを構築します。",
      points: ["主要設備一覧・保有技術の構造化表示", "PDFカタログダウンロード機能", "SSL＆DNSセキュリティ完全防護"]
    },
    {
      id: "professional",
      label: "士業・専門サービス",
      title: "安心感と専門性を醸成するミニマルで誠実なデザイン",
      description: "過剰な装飾を排し、相談者が求めている解決策と費用体系をクリアに提示。SSL暗号化と高セキュリティでお問い合わせを保護します。",
      points: ["明瞭な料金体系テーブル", "初回相談受付カレンダー導線", "プライバシーポリシー・セキュリティ基準準拠"]
    }
  ]
} = Astro.props;
---

<div class="max-w-4xl mx-auto space-y-8">
  <div class="text-left md:text-center space-y-2">
    <span class="font-mono text-xs text-stone-400 tracking-widest uppercase block">{eyebrow}</span>
    <h3 class="font-serif-title text-xl md:text-2xl font-medium text-stone-900">{title}</h3>
  </div>

  <!-- タブボタン切り替えコンテナ -->
  <div class="tab-container border border-stone-200 rounded-sm bg-white overflow-hidden shadow-xs">
    <div class="flex border-b border-stone-200 bg-stone-50 overflow-x-auto text-sm font-medium" role="tablist">
      {tabs.map((tab, idx) => (
        <button 
          type="button" 
          role="tab"
          aria-selected={idx === 0 ? "true" : "false"}
          data-tab-id={tab.id}
          class={`tab-button relative px-6 py-3.5 border-r border-stone-200 whitespace-nowrap transition-all duration-200 cursor-pointer ${
            idx === 0 
              ? 'bg-white font-bold text-stone-900 border-b-2 border-b-stone-900 shadow-2xs' 
              : 'text-stone-600 hover:text-stone-900 hover:bg-stone-100/80'
          }`}
        >
          <span>{tab.label}</span>
        </button>
      ))}
    </div>

    <!-- コンテンツ表示エリア（タブ切り替え対応） -->
    <div class="p-8">
      {tabs.map((tab, idx) => (
        <div 
          data-panel-id={tab.id} 
          role="tabpanel"
          class={`tab-panel space-y-4 transition-opacity duration-300 ${idx === 0 ? 'block opacity-100' : 'hidden opacity-0'}`}
        >
          <h4 class="font-serif-title text-lg sm:text-xl font-medium text-stone-900">
            {tab.title}
          </h4>
          <p class="text-sm sm:text-base text-stone-600 font-light leading-relaxed">
            {tab.description}
          </p>
          <div class="pt-4 border-t border-stone-100">
            <ul class="space-y-2.5 text-sm text-stone-700 font-light">
              {tab.points.map((pt) => (
                <li class="flex items-center gap-2">
                  <span class="text-stone-900 font-bold">✓</span>
                  <span>{pt}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  function initTabs() {
    const containers = document.querySelectorAll('.tab-container');

    containers.forEach((container) => {
      if (container.getAttribute('data-initialized') === 'true') return;
      container.setAttribute('data-initialized', 'true');

      const buttons = container.querySelectorAll<HTMLButtonElement>('.tab-button');
      const panels = container.querySelectorAll<HTMLElement>('.tab-panel');

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetId = btn.getAttribute('data-tab-id');
          if (!targetId) return;

          // ボタン状態更新
          buttons.forEach((b) => {
            const isTarget = b === btn;
            b.setAttribute('aria-selected', isTarget ? 'true' : 'false');
            if (isTarget) {
              b.className = 'tab-button relative px-6 py-3.5 border-r border-stone-200 whitespace-nowrap transition-all duration-200 cursor-pointer bg-white font-bold text-stone-900 border-b-2 border-b-stone-900 shadow-2xs';
            } else {
              b.className = 'tab-button relative px-6 py-3.5 border-r border-stone-200 whitespace-nowrap transition-all duration-200 cursor-pointer text-stone-600 hover:text-stone-900 hover:bg-stone-100/80';
            }
          });

          // パネル表示更新
          panels.forEach((p) => {
            const panelId = p.getAttribute('data-panel-id');
            if (panelId === targetId) {
              p.classList.remove('hidden');
              requestAnimationFrame(() => {
                p.classList.remove('opacity-0');
                p.classList.add('opacity-100');
              });
            } else {
              p.classList.add('hidden', 'opacity-0');
              p.classList.remove('opacity-100');
            }
          });
        });
      });
    });
  }

  initTabs();
  document.addEventListener('astro:page-load', initTabs);
</script>
