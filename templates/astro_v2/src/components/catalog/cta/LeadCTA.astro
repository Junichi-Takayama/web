---
export interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
  primaryButtonLabel?: string;
  primaryButtonHref?: string;
  secondaryButtonLabel?: string;
  secondaryButtonHref?: string;
  contactNote?: string;
}

const {
  eyebrow = "Next Action",
  title = "まずは、貴社サイトの現状を客観的な数値で把握しませんか？",
  lead = "表示速度やサーバー安全性、現在のWordPress更新リスクを調査する「Webサイト無料診断レポート」をお届けします。強引な営業は一切行いません。",
  primaryButtonLabel = "Webサイト無料診断を申し込む",
  primaryButtonHref = "/contact/",
  secondaryButtonLabel = "サービス概要・料金を見る",
  secondaryButtonHref = "/service/",
  contactNote = "お電話（平日 9:00〜18:00）またはオンラインZOOM相談も可能です。"
} = Astro.props;
---

<section class="py-20 md:py-28 px-6 bg-stone-900 text-white relative overflow-hidden">
  <div class="max-w-4xl mx-auto text-center space-y-8 relative z-10">
    <span class="font-mono text-xs text-stone-400 tracking-widest uppercase block">
      {eyebrow}
    </span>
    <h2 class="font-serif-title text-2xl md:text-4xl font-medium tracking-wide leading-snug text-white max-w-2xl mx-auto">
      {title}
    </h2>
    <p class="text-xs md:text-sm text-stone-300 font-light leading-relaxed max-w-xl mx-auto">
      {lead}
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
      <a 
        href={primaryButtonHref} 
        class="w-full sm:w-auto px-8 py-3.5 bg-stone-100 text-stone-900 font-bold text-xs tracking-widest uppercase hover:bg-white transition shadow-sm rounded-sm"
      >
        {primaryButtonLabel} &rarr;
      </a>
      {secondaryButtonLabel && (
        <a 
          href={secondaryButtonHref} 
          class="w-full sm:w-auto px-8 py-3.5 border border-stone-700 text-stone-300 hover:text-white hover:border-stone-500 font-medium text-xs tracking-widest uppercase transition rounded-sm"
        >
          {secondaryButtonLabel}
        </a>
      )}
    </div>

    {contactNote && (
      <p class="text-[11px] text-stone-500 font-light">
        {contactNote}
      </p>
    )}
  </div>
</section>
