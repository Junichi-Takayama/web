---
export interface Props {
  actionUrl?: string;
  submitLabel?: string;
  privacyHref?: string;
}

const {
  actionUrl = "/contact/thanks/",
  submitLabel = "無料診断・ご相談を送信する",
  privacyHref = "/privacy/"
} = Astro.props;
---

<div class="max-w-2xl mx-auto bg-white p-8 sm:p-10 border border-stone-200 rounded-sm shadow-xs">
  <form action={actionUrl} method="GET" class="space-y-6 text-xs">
    <!-- ご相談項目 -->
    <div class="space-y-2">
      <label class="block font-bold text-stone-900">
        ご相談の項目 <span class="text-rose-600 font-mono">*</span>
      </label>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-stone-700">
        <label class="flex items-center gap-2 p-3 border border-stone-200 rounded-sm hover:bg-stone-50 cursor-pointer">
          <input type="checkbox" name="services" value="free_audit" checked class="rounded-xs text-stone-900 focus:ring-stone-900" />
          <span>Webサイト無料診断</span>
        </label>
        <label class="flex items-center gap-2 p-3 border border-stone-200 rounded-sm hover:bg-stone-50 cursor-pointer">
          <input type="checkbox" name="services" value="renewal" class="rounded-xs text-stone-900 focus:ring-stone-900" />
          <span>Web基盤換装・リニューアル</span>
        </label>
        <label class="flex items-center gap-2 p-3 border border-stone-200 rounded-sm hover:bg-stone-50 cursor-pointer">
          <input type="checkbox" name="services" value="partner" class="rounded-xs text-stone-900 focus:ring-stone-900" />
          <span>月次伴走サポート（GA4解析/代行）</span>
        </label>
        <label class="flex items-center gap-2 p-3 border border-stone-200 rounded-sm hover:bg-stone-50 cursor-pointer">
          <input type="checkbox" name="services" value="other" class="rounded-xs text-stone-900 focus:ring-stone-900" />
          <span>その他・概算見積のご相談</span>
        </label>
      </div>
    </div>

    <!-- 貴社名 & お名前 -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="space-y-1.5">
        <label class="block font-bold text-stone-900">
          貴社名 / 屋号 <span class="text-rose-600 font-mono">*</span>
        </label>
        <input 
          type="text" 
          name="company" 
          placeholder="例：株式会社〇〇工務店" 
          required 
          class="w-full px-3.5 py-2.5 border border-stone-300 rounded-sm focus:outline-hidden focus:border-stone-900 focus:ring-1 focus:ring-stone-900"
        />
      </div>
      <div class="space-y-1.5">
        <label class="block font-bold text-stone-900">
          ご担当者様名 <span class="text-rose-600 font-mono">*</span>
        </label>
        <input 
          type="text" 
          name="name" 
          placeholder="例：山田 太郎" 
          required 
          class="w-full px-3.5 py-2.5 border border-stone-300 rounded-sm focus:outline-hidden focus:border-stone-900 focus:ring-1 focus:ring-stone-900"
        />
      </div>
    </div>

    <!-- メールアドレス & 現行URL -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="space-y-1.5">
        <label class="block font-bold text-stone-900">
          メールアドレス <span class="text-rose-600 font-mono">*</span>
        </label>
        <input 
          type="email" 
          name="email" 
          placeholder="name@example.com" 
          required 
          class="w-full px-3.5 py-2.5 border border-stone-300 rounded-sm focus:outline-hidden focus:border-stone-900 focus:ring-1 focus:ring-stone-900"
        />
      </div>
      <div class="space-y-1.5">
        <label class="block font-bold text-stone-900">
          現行サイトURL
        </label>
        <input 
          type="url" 
          name="site_url" 
          placeholder="https://example.com" 
          class="w-full px-3.5 py-2.5 border border-stone-300 rounded-sm focus:outline-hidden focus:border-stone-900 focus:ring-1 focus:ring-stone-900"
        />
      </div>
    </div>

    <!-- お困りごと -->
    <div class="space-y-1.5">
      <label class="block font-bold text-stone-900">
        現在のお困りごと・ご要望
      </label>
      <textarea 
        name="message" 
        rows="4" 
        placeholder="例：WordPressが重く更新が止まっている、スマホ表示を速くしたい等" 
        class="w-full px-3.5 py-2.5 border border-stone-300 rounded-sm focus:outline-hidden focus:border-stone-900 focus:ring-1 focus:ring-stone-900 resize-y"
      ></textarea>
    </div>

    <!-- プライバシー同意 -->
    <div class="pt-2 text-center text-[11px] text-stone-500">
      <label class="inline-flex items-center gap-2 cursor-pointer">
        <input type="checkbox" required class="rounded-xs text-stone-900 focus:ring-stone-900" />
        <span><a href={privacyHref} target="_blank" class="underline hover:text-stone-900">個人情報の取り扱い</a>に同意する</span>
      </label>
    </div>

    <!-- 送信ボタン -->
    <div class="pt-2">
      <button 
        type="submit" 
        class="w-full py-3.5 bg-stone-900 text-white font-medium text-xs tracking-widest uppercase hover:bg-stone-800 transition rounded-sm shadow-sm cursor-pointer"
      >
        {submitLabel} &rarr;
      </button>
    </div>
  </form>
</div>
