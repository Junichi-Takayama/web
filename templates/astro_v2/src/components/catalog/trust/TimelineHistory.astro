---
export interface TimelineItem {
  year: string;
  month?: string;
  title: string;
  description: string;
}

export interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  items?: TimelineItem[];
}

const {
  eyebrow = "Company History",
  title = "歩みとこれまでの軌跡",
  subtitle = "地方の中小企業・工務店とともに歩んできた成長の歴史です。",
  items = [
    { year: "2020", month: "04", title: "地方特化のWebコンサルティング事業を開始", description: "工務店・地域企業のWeb集客支援およびマーケティング伴走をスタート。" },
    { year: "2023", month: "10", title: "ヘッドレスCMS×静的生成の本格導入", description: "従来のCMS保守崩壊リスクを解消するため、JAMstack/Astro技術の研究開発に着手。" },
    { year: "2026", month: "09", title: "次世代Webエンジン「ArCraft」公式ローンチ", description: "地方中小企業向け超高速Webエンジン＆生涯メンテナンスフリー基盤の提供を開始。" }
  ]
} = Astro.props;
---

<section class="py-20 md:py-28 px-6 bg-white">
  <div class="max-w-4xl mx-auto space-y-12">
    <div class="text-center max-w-2xl mx-auto space-y-3">
      <span class="font-mono text-xs text-stone-400 tracking-widest uppercase block">{eyebrow}</span>
      <h2 class="font-serif-title text-2xl md:text-3xl font-medium text-stone-900 tracking-wide">{title}</h2>
      <p class="text-xs text-stone-600 font-light leading-relaxed">{subtitle}</p>
    </div>

    <div class="relative border-l border-stone-200 ml-4 md:ml-32 space-y-10 pl-6 md:pl-8">
      {items.map((item) => (
        <div class="relative p-3 -m-3">
          <!-- タイムラインの丸ポチ -->
          <div class="absolute -left-[31px] md:-left-[39px] top-4 w-3.5 h-3.5 rounded-full bg-stone-900 border-4 border-white shadow-xs"></div>

          <!-- 年月表示（モバイルは上、PCは左側） -->
          <div class="md:absolute md:-left-36 md:top-3 md:text-right font-mono text-xs text-stone-500 font-semibold mb-1 md:mb-0">
            {item.year}{item.month ? `.${item.month}` : ''}
          </div>

          <div class="space-y-1">
            <h3 class="font-serif-title text-base font-bold text-stone-900">
              {item.title}
            </h3>
            <p class="text-xs text-stone-600 font-light leading-relaxed">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
