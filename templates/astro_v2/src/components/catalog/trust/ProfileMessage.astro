---
export interface Props {
  eyebrow?: string;
  name?: string;
  title?: string;
  lead?: string;
  paragraphs?: string[];
  signatureTitle?: string;
  imageSrc?: string;
  imageAlt?: string;
}

const {
  eyebrow = "Director's Message",
  name = "高山 潤一",
  title = "「作って終わり」のWeb制作は、もう終わりにしたい。",
  lead = "地方の中小企業が本当に必要としているのは、何百万もかけた派手なリニューアルではなく、一度作れば絶対に壊れず、横に並んで伴走してくれるWeb基盤です。",
  paragraphs = [
    "これまで多くの経営者様から『制作会社に連絡しても返信が遅い』『WordPressのアップデートが怖くて触れない』という切実な悩みを伺ってきました。",
    "ArCraftは、最先端の静的生成エンジンAstroとCloudflareのインフラを活用し、生涯修理費ゼロの安心と、毎月の改善伴走をお届けします。"
  ],
  signatureTitle = "ArCraft 代表ディレクター / 伴走支援責任者",
  imageSrc = "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=600&q=80",
  imageAlt = "高山 潤一"
} = Astro.props;
---

<section class="py-20 md:py-28 px-6 bg-stone-50 border-t border-b border-stone-200">
  <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-10 items-center">
    <!-- プロフィール画像 -->
    <div class="space-y-4 text-center md:text-left">
      <div class="aspect-square max-w-[280px] mx-auto md:mx-0 overflow-hidden rounded-sm bg-stone-200 shadow-sm">
        <img 
          src={imageSrc} 
          alt={imageAlt} 
          class="w-full h-full object-cover grayscale" 
          loading="lazy" 
        />
      </div>
      <div>
        <p class="font-serif-title text-base md:text-lg font-medium text-stone-900">{name}</p>
        <p class="text-sm text-stone-500 font-mono tracking-wider mt-0.5">{signatureTitle}</p>
      </div>
    </div>

    <!-- メッセージテキスト -->
    <div class="md:col-span-2 space-y-6">
      <span class="font-mono text-xs text-stone-400 tracking-widest uppercase block">{eyebrow}</span>
      <h2 class="font-serif-title text-xl sm:text-2xl md:text-3xl font-medium text-stone-900 leading-snug">
        {title}
      </h2>
      <p class="text-base text-stone-900 font-medium leading-relaxed">
        {lead}
      </p>
      <div class="space-y-3 text-xs text-stone-600 font-light leading-relaxed">
        {paragraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </div>
  </div>
</section>
