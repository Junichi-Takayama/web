# ==========================================
# microCMS API 連携設定 (.env.example)
# ==========================================
# microCMS 管理画面の「サービス設定」>「APIキー」から取得してください。
# ※ 本ファイルを .env にコピーして実際の値を設定してください（Gitコミット厳禁）

MICROCMS_SERVICE_DOMAIN=your-service-domain
MICROCMS_API_KEY=your-api-key

# ==========================================
# Web3Forms 設定 (お問い合わせフォーム)
# ==========================================
# Web3Forms（https://web3forms.com）で発行された Access Key
PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key
