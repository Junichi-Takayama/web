---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/common/PageHeader.astro';
---

<Layout title="お知らせ | 汎用工務店テンプレート">
  <PageHeader title="お知らせ" />

  <section class="py-20 px-4 max-w-4xl mx-auto">
    <div class="border-t border-b border-neutral-300 divide-y divide-neutral-200 mb-12">
      {[...Array(12)].map(() => (
        <div class="py-4 flex flex-col sm:flex-row sm:items-center gap-4 text-xs">
          <span class="text-neutral-500 font-mono">2020.01.01</span>
          <span class="px-3 py-1 bg-black text-white text-[10px] font-bold tracking-wider uppercase">Category</span>
          <a href="/news/2026-08-24-sample/" class="text-neutral-800 font-medium hover:underline flex-grow">
            タイトルタイトルタイトルタイトルタイトルタイトルタイトル
          </a>
        </div>
      ))}
    </div>

    <!-- ページネーション -->
    <div class="flex items-center justify-center gap-2 text-xs font-bold">
      <span class="w-10 h-10 bg-black text-white flex items-center justify-center">&lt;</span>
      <span class="w-10 h-10 bg-black text-white flex items-center justify-center">1</span>
      <a href="#" class="w-10 h-10 border border-neutral-300 flex items-center justify-center hover:bg-neutral-100">2</a>
      <span class="px-2 text-neutral-400">. . . . .</span>
      <a href="#" class="w-10 h-10 border border-neutral-300 flex items-center justify-center hover:bg-neutral-100">10</a>
    </div>
  </section>
</Layout>

