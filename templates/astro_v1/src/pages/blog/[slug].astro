---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/common/PageHeader.astro';

export function getStaticPaths() {
  return [
    { params: { slug: 'sample-post' } },
  ];
}
---

<Layout title="ブログ詳細 | 汎用工務店テンプレート">
  <PageHeader title="ブログ" />

  <section class="py-20 px-4 max-w-6xl mx-auto">
    <div class="grid lg:grid-cols-12 gap-12">
      <!-- メインコンテンツ -->
      <div class="lg:col-span-8 space-y-8">
        <div>
          <h1 class="text-2xl font-bold text-neutral-800 mb-4">タイトル</h1>
          <div class="flex flex-wrap gap-2 text-xs">
            <span class="px-3 py-1 bg-black text-white text-[10px] font-bold">タクソノミ</span>
            <span class="px-3 py-1 bg-black text-white text-[10px] font-bold">タクソノミ</span>
            <span class="px-3 py-1 bg-black text-white text-[10px] font-bold">タクソノミ</span>
            <span class="px-3 py-1 bg-black text-white text-[10px] font-bold">タクソノミ</span>
          </div>
        </div>

        <div class="space-y-6 text-xs text-neutral-700 leading-relaxed">
          <h2 class="text-lg font-bold text-neutral-900 border-b border-neutral-300 pb-2">見出し2</h2>
          <p>
            テキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキスト
          </p>

          <div class="aspect-[16/9] bg-neutral-300 my-6"></div>

          <h3 class="text-base font-bold text-neutral-900 border-b border-neutral-200 pb-1">見出し3</h3>
          <p>
            テキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキストテキスト
          </p>
        </div>

        <div class="pt-8 border-t border-neutral-200">
          <a href="/blog/" class="w-10 h-10 bg-black text-white flex items-center justify-center font-bold text-xs hover:bg-neutral-800 transition">
            &lt;
          </a>
        </div>
      </div>

      <!-- 右サイドバー -->
      <aside class="lg:col-span-4 space-y-6">
        <h3 class="text-sm font-bold text-neutral-800 border-b border-neutral-800 pb-2">タイトル一覧</h3>
        <div class="space-y-4 text-xs">
          {[1, 2, 3, 4, 5].map(() => (
            <div class="flex gap-3 items-center">
              <div class="w-16 h-12 bg-neutral-300 flex-shrink-0"></div>
              <p class="font-bold text-neutral-800 leading-snug line-clamp-2">
                <a href="/blog/sample-post/" class="hover:underline">タイトルタイトル</a>
              </p>
            </div>
          ))}
        </div>
      </aside>
    </div>
  </section>
</Layout>
