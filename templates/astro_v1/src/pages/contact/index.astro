---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/common/PageHeader.astro';
---

<Layout title="お問い合わせ | 汎用工務店テンプレート">
  <PageHeader title="お問い合わせ" />

  <section class="py-20 px-4 max-w-4xl mx-auto space-y-16">
    <!-- お電話でお問い合わせ -->
    <div class="text-center space-y-4">
      <h2 class="text-xl font-bold text-neutral-800">お電話でのお問い合わせ</h2>
      <p class="text-3xl md:text-4xl font-bold text-neutral-900 tracking-wider">025-XXX-XXXX</p>
      <p class="text-xs text-neutral-500">受付時間 8:00〜18:00（日曜祝日を除きます）</p>
    </div>

    <!-- メールフォームでお問い合わせ -->
    <div class="space-y-8">
      <div class="text-center space-y-2">
        <h2 class="text-xl font-bold text-neutral-800">メールフォームでのお問い合わせ</h2>
        <p class="text-xs text-neutral-600">
          メールでのお問い合わせをご希望のお客様は、<br />下記フォームよりお問い合わせください。
        </p>
      </div>

      <div class="bg-neutral-100 p-8 md:p-12 rounded">
        <form action="/contact/thanks" method="GET" class="space-y-6 text-xs">
          <div class="grid grid-cols-1 md:grid-cols-4 gap-2 items-center border-b border-neutral-300 pb-4">
            <label class="font-bold text-neutral-800 md:col-span-1">会社名・屋号</label>
            <input type="text" class="md:col-span-3 w-full p-2.5 border border-neutral-400 bg-white rounded" />
          </div>

          <div class="grid grid-cols-1 md:grid-cols-4 gap-2 items-center border-b border-neutral-300 pb-4">
            <label class="font-bold text-neutral-800 md:col-span-1">お名前</label>
            <input type="text" required class="md:col-span-3 w-full p-2.5 border border-neutral-400 bg-white rounded" />
          </div>

          <div class="grid grid-cols-1 md:grid-cols-4 gap-2 items-center border-b border-neutral-300 pb-4">
            <label class="font-bold text-neutral-800 md:col-span-1">電話番号</label>
            <input type="tel" class="md:col-span-3 w-full p-2.5 border border-neutral-400 bg-white rounded" />
          </div>

          <div class="grid grid-cols-1 md:grid-cols-4 gap-2 items-start border-b border-neutral-300 pb-4">
            <label class="font-bold text-neutral-800 md:col-span-1 pt-2">住所</label>
            <div class="md:col-span-3 space-y-2">
              <input type="text" placeholder="郵便番号" class="w-1/3 p-2.5 border border-neutral-400 bg-white rounded" />
              <input type="text" placeholder="ご住所" class="w-full p-2.5 border border-neutral-400 bg-white rounded" />
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-4 gap-2 items-center border-b border-neutral-300 pb-4">
            <label class="font-bold text-neutral-800 md:col-span-1">メールアドレス</label>
            <input type="email" required class="md:col-span-3 w-full p-2.5 border border-neutral-400 bg-white rounded" />
          </div>

          <div class="grid grid-cols-1 md:grid-cols-4 gap-2 items-start pt-2">
            <label class="font-bold text-neutral-800 md:col-span-1 pt-2">お問い合わせ内容</label>
            <textarea rows="6" required class="md:col-span-3 w-full p-2.5 border border-neutral-400 bg-white rounded"></textarea>
          </div>

          <div class="text-center pt-8">
            <button type="submit" class="px-16 py-4 bg-black text-white font-bold text-xs hover:bg-neutral-800 transition tracking-widest">
              送信
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>
</Layout>

