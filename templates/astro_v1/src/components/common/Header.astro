---
---
<header class="bg-white/95 backdrop-blur-md border-b border-neutral-200 sticky top-0 z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 md:px-8 h-20 flex items-center justify-between">
    <!-- ロゴ枠 -->
    <a href="/" class="w-40 h-10 border border-neutral-300 flex items-center justify-center text-xs font-bold text-neutral-700 hover:bg-neutral-50 transition transform hover:-translate-y-0.5">
      ロゴ / 社名
    </a>

    <!-- デスクトップナビゲーション -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-neutral-800">
      <a href="/" class="hover:text-neutral-500 transition duration-200">トップ</a>
      <a href="/works/" class="hover:text-neutral-500 transition duration-200">施工事例</a>
      <a href="/news/" class="hover:text-neutral-500 transition duration-200">お知らせ</a>
      <a href="/blog/" class="hover:text-neutral-500 transition duration-200">ブログ</a>
      <a href="/company/" class="hover:text-neutral-500 transition duration-200">会社概要</a>
      <a href="/contact/" class="px-6 py-3 bg-neutral-800 hover:bg-neutral-900 text-white font-bold transition duration-200 text-xs tracking-wider shadow-sm hover:shadow">
        お問い合わせ
      </a>
    </nav>

    <!-- モバイルハンバーガーボタン -->
    <button id="mobile-menu-btn" class="md:hidden p-2 text-neutral-800 focus:outline-none" aria-label="メニューを開く">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path id="hamburger-icon" class="transition-all duration-300" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- モバイルメニュー（ドロワーアニメーション） -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-b border-neutral-200 px-6 py-6 transition-all duration-300 opacity-0 -translate-y-4">
    <nav class="flex flex-col gap-4 text-sm font-medium text-neutral-800">
      <a href="/" class="py-2 border-b border-neutral-100 hover:text-neutral-500">トップ</a>
      <a href="/works/" class="py-2 border-b border-neutral-100 hover:text-neutral-500">施工事例</a>
      <a href="/news/" class="py-2 border-b border-neutral-100 hover:text-neutral-500">お知らせ</a>
      <a href="/blog/" class="py-2 border-b border-neutral-100 hover:text-neutral-500">ブログ</a>
      <a href="/company/" class="py-2 border-b border-neutral-100 hover:text-neutral-500">会社概要</a>
      <a href="/contact/" class="mt-2 text-center py-3 bg-neutral-800 text-white font-bold text-xs">
        お問い合わせ
      </a>
    </nav>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    let isOpen = false;

    if (btn && menu) {
      btn.addEventListener('click', () => {
        isOpen = !isOpen;
        if (isOpen) {
          menu.classList.remove('hidden');
          // アニメーション用にタイミングをずらす
          setTimeout(() => {
            menu.classList.remove('opacity-0', '-translate-y-4');
            menu.classList.add('opacity-100', 'translate-y-0');
          }, 10);
        } else {
          menu.classList.remove('opacity-100', 'translate-y-0');
          menu.classList.add('opacity-0', '-translate-y-4');
          setTimeout(() => {
            menu.classList.add('hidden');
          }, 300);
        }
      });
    }
  });
</script>


