# ==========================================
# 個人PC用 環境変数設定テンプレート (.env.example)
# ==========================================
# ※ このファイルをコピーして「.env」を作成し、キーを設定してください。

# Semrush API Key (SEO・キーワード分析用)
SEMRUSH_API_KEY=

# Figma Personal Access Token (Figma Bridge / デザイン自動生成用)
FIGMA_PAT=

# GitHub Personal Access Token
GITHUB_TOKEN=

# Cloudflare (必要に応じて)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
